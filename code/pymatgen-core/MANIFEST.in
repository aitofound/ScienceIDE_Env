# setuptools-scm includes every git-tracked file in the sdist by default.
# Prune everything not needed to build/install the package.
prune test-files
prune tests
prune dev_scripts
prune assets
prune .github
exclude .gitignore .pre-commit-config.yaml
exclude ADMIN.md AGENTS.md SECURITY.md CITATION.cff tasks.py uv.lock
