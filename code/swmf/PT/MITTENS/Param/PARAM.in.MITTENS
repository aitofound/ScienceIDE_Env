#CPUTIMEMAX
28440       CpuTimeMax # 28440

#READMHDATA
T                     DoReadMhData
/mnt/e/Fieldline_20130411    NameInputDir
1      iLonFile
1      iLatFile

#MHDATA
ascii       TypeFile
MH_data.lst     NameTagFile

#COORDSYSTEM
GSM      TypeCoordSystem

#FIELDLINEGRID
1               nLat
1               nLon

#STOP
2000        nIterMax
7200        TimeMax # [s] max = 153720

#BOUNDARY
reflect      BoundaryInner
absorb       BoundaryOuter

#ADVECTION
T       UseLogScaling

#SHOCK
T           DoSharpenShock
100         nSearchMax
0.0001      dLogRhoThreshold


#SDEBINNING
T           DoBinEntireFieldline
500         nLagrBins
120         BinTimeWindow  # [s]

#DISTRIBUTION
200         nEnergyBin
1.0         eBinMin        # [keV]
1e7         eBinMax        # [keV]
10.0        InjEnergy      # [keV]
1.0         InjCoeff

#SDE
1.0           TimeStepFactor 
10.0          MaxTimeStep       # [s]

#DIFFUSION
PSP                 UpstreamDxxModel     # (1) MHD (2) PSP (3) Analytical
0.03                CorrelationLength    # default = 0.03
1.0                 ScalingFactor        # Scales MHD Dxx
F                   UseConstantDiffusion # Only for testing purposes

#PARTICLE
0               nInject        # how many psuedo-particles injected per lagrangian coordinate
F               UseSplit
10              nSplit         # number of energy thresholds where splitting occurs
1.0             SplitEnergyMin # [MeV]
100.0           SplitEnergyMax # [MeV]

#INPUTSEED
F               UseInputSeedFile

#TEST
F           DoRunTest

#END