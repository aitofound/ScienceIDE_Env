! =============================================================================
! December 2006 shared-mesh production deck: 475-km and 850-km access shells
!
! This is the authoritative mesh-reuse template for the research study.  The
! two observation altitudes use the same IGRF+TS05 field mesh, rigidity list,
! trace controls, and spatial resolution.  In BATCHED mode the runner inserts a
! #TEMPORAL/SNAPSHOT_LIST block into the rendered copy.  Mode3D then allocates
! the AMR topology once for the batch, but refreshes the TS05/IGRF field values,
! Geopack state, and cutoff calculation at every listed epoch.  Reusing topology
! is a numerical optimization; reusing magnetic-field values would erase the
! storm-time variability being measured and is explicitly not done.
!
! The runner copies this file into a self-contained case directory, places the
! verified driver and snapshot list beside it, and replaces only documented
! directives.  PER_EPOCH leaves this template in ordinary SNAPSHOT mode;
! STANDALONE continues to use the one-shell templates as an equivalence baseline.
! =============================================================================

#CALCULATION_MODE
CALC_TARGET             CUTOFF_RIGIDITY
FIELD_EVAL_METHOD       GRID_3D

#CUTOFF_RIGIDITY
! The bracket is expressed in proton kinetic energy because it is required by
! the common parser.  The exact scientific workset is the rigidity list below.
CUTOFF_EMIN             11.9145
CUTOFF_EMAX             624.691
CUTOFF_MAX_PARTICLES    1
CUTOFF_NENERGY          50
CUTOFF_SAMPLING         VERTICAL
CUTOFF_SEARCH_ALGORITHM RIGIDITY_LIST
CUTOFF_UPPER_SCAN_N     160
CUTOFF_RIGIDITY_LIST_GV 0.15,0.174013525,0.20,0.25,0.262395866,0.30,0.35,0.369131538,0.40,0.423556372,0.45,0.498397432,0.50,0.531334344,0.55,0.587877538,0.60,0.65,0.692820323,0.70,0.75,0.80,0.817006732,0.85,0.90,0.95,0.962081078,1.00,1.05,1.10,1.131017241,1.15,1.20,1.25
CUTOFF_ACCESS_ABS_LAT_MIN 35.0
CUTOFF_ACCESS_ABS_LAT_MAX 85.0
CUTOFF_SCAN_SPACING     LINEAR
CUTOFF_TRACE_POLICY     ACCURATE
CUTOFF_BACKTRACE_CHARGE REVERSED
CUTOFF_TRACE_LIMIT_POLICY FORBIDDEN
CUTOFF_MAX_TRAJ_TIME    300.0

#PARTICLE_SPECIES
SPECIES                 PROTON
CHARGE                  1
MASS_AMU                1.007276466621

#BACKGROUND_FIELD
! The runner passes this epoch on the command line and samples the same
! checksum-verified driver independently for every modeled snapshot.
FIELD_MODEL             T05
EPOCH                   2006-12-14T00:00:00
DRIVER_FILE             ts05_driver.txt
! Parser-safe fallbacks are overridden whenever the event driver is loaded.
DST                     -100.0
PDYN                    4.0
IMF_BX                  0.0
IMF_BY                  0.0
IMF_BZ                  -5.0
SW_VX                   -450.0
SW_N                    5.0
T05_W1                  0.0
T05_W2                  0.0
T05_W3                  0.0
T05_W4                  0.0
T05_W5                  0.0
T05_W6                  0.0

#MODE3D_MESH
! Identical mesh controls are a precondition for safe topology reuse.
MODE3D_MESH_RES_EARTH_RE     0.02
MODE3D_MESH_RES_BOUNDARY_RE  2.0
MODE3D_MESH_COARSENING       LINEAR
MODE3D_MESH_EXPONENT         1.0

#DOMAIN_BOUNDARY
DOMAIN_X_MIN            -159280.0
DOMAIN_X_MAX             159280.0
DOMAIN_Y_MIN            -159280.0
DOMAIN_Y_MAX             159280.0
DOMAIN_Z_MIN            -159280.0
DOMAIN_Z_MAX             159280.0
R_INNER                  6371.2

#SPECTRUM
! Required by the common parser; not used by fixed-rigidity cutoff tracing.
SPECTRUM_TYPE           POWER_LAW
SPEC_J0                 1.0
SPEC_GAMMA              2.0
SPEC_E0                 1000.0
SPEC_EMIN               1.0
SPEC_EMAX               2000.0

#OUTPUT_DOMAIN
! Both geodetic shells are written as distinct altitude-labelled Tecplot zones.
! The postprocessor rejects output that cannot identify every requested shell.
OUTPUT_MODE             SHELLS
SHELL_COUNT             2
SHELL_ALTS_KM           475.0 850.0
SHELL_LON_RES_DEG       15.0
SHELL_LAT_RES_DEG       2.0
SHELL_GEOMETRY          GEODETIC

#OUTPUT_OPTIONS
OUTPUT_COORDS           GEO

#NUMERICAL
DT_TRACE                0.2
ADAPTIVE_DT             T
MAX_STEPS               500000
MAX_TRACE_TIME          300.0
MAX_TRACE_DISTANCE      400.0
TRAP_DETECTION          T

!#END
