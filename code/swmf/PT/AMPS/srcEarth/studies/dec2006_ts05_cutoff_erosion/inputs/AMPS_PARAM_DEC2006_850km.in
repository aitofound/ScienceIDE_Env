! =============================================================================
! December 2006 production study: 850-km rigidity-access morphology shell
!
! This deck produces the common-rigidity morphology product at the representative
! POES/MetOp altitude.  It is separate from the C10 observation-equivalent run:
! C10 uses four nominal channel thresholds and exact NOAA sampling, whereas this
! deck supplies a dense enough rigidity series for physical storm diagnostics.
! The fixed assumptions are a geodetic shell, vertical protons, frozen IGRF+TS05,
! zero electric field, Mode3D interpolation, DIRECT_ACCESS/RIGIDITY_LIST, and
! explicit unresolved-state accounting.  P6/P7 rigidities remain identifiable
! as primary observation anchors; P8/P9 are diagnostic instrument anchors.
!
! scripts/run_morphology.py copies this template per epoch and archives the
! generated input, driver, command, log, raw access map, T50 profiles, and
! MLT-resolved boundaries.  The same C10 parser and isotonic reducer are reused.
! =============================================================================

#CALCULATION_MODE
CALC_TARGET             CUTOFF_RIGIDITY
FIELD_EVAL_METHOD       GRID_3D

#CUTOFF_RIGIDITY
! The configured 0.15--1.25 GV study range is expressed as proton kinetic
! energy because the common AMPS cutoff parser still requires the bracket.
CUTOFF_EMIN             11.9145
CUTOFF_EMAX             624.691
CUTOFF_MAX_PARTICLES    1
CUTOFF_NENERGY          50
CUTOFF_SAMPLING         VERTICAL
CUTOFF_SEARCH_ALGORITHM RIGIDITY_LIST
CUTOFF_UPPER_SCAN_N     120
CUTOFF_SCAN_SPACING     LINEAR
! This deck is intentionally RIGIDITY_LIST/DIRECT_ACCESS.  It classifies every
! listed rigidity directly within the configured latitude band.  The Python
! postprocessor computes MLT-resolved ACCESS_T50 from resolved states and keeps
! the unresolved weight as a separate numerical diagnostic.
CUTOFF_RIGIDITY_LIST_GV 0.15,0.174013525,0.20,0.25,0.262395866,0.30,0.35,0.369131538,0.40,0.423556372,0.45,0.498397432,0.50,0.531334344,0.55,0.587877538,0.60,0.65,0.692820323,0.70,0.75,0.80,0.817006732,0.85,0.90,0.95,0.962081078,1.00,1.05,1.10,1.131017241,1.15,1.20,1.25
CUTOFF_ACCESS_ABS_LAT_MIN 35.0
CUTOFF_ACCESS_ABS_LAT_MAX 85.0
CUTOFF_TRACE_POLICY     ACCURATE
CUTOFF_BACKTRACE_CHARGE REVERSED
CUTOFF_TRACE_LIMIT_POLICY FORBIDDEN
CUTOFF_MAX_TRAJ_TIME    300.0

#PARTICLE_SPECIES
SPECIES                 PROTON
CHARGE                  1
MASS_AMU                1.007276466621

#BACKGROUND_FIELD
! The driver table is sampled once at EPOCH for each standalone snapshot run.
! The study runner copies the checksum-verified event driver beside this input.
FIELD_MODEL             T05
EPOCH                   2006-12-14T00:00:00
DRIVER_FILE             ts05_dec2006_5min.txt
! Static values are parser-safe fallbacks only.  A loaded driver overrides them.
DST                     -100.0
PDYN                    4.0
IMF_BX                  0.0
IMF_BY                  0.0
IMF_BZ                  -5.0
SW_VX                   -450.0
SW_N                    5.0
T05_W1                  0.0
T05_W2                  0.0
T05_W3                  0.0
T05_W4                  0.0
T05_W5                  0.0
T05_W6                  0.0

#MODE3D_MESH
! Near-Earth resolution controls interpolation accuracy where the 850-km
! access boundary is determined.  The 0.02-Re near-Earth target is the
! production starting point; repeat selected event landmarks with 0.01 Re for
! mesh convergence.
MODE3D_MESH_RES_EARTH_RE     0.02
MODE3D_MESH_RES_BOUNDARY_RE  2.0
MODE3D_MESH_COARSENING       LINEAR
MODE3D_MESH_EXPONENT         1.0

#DOMAIN_BOUNDARY
! Bare lengths are kilometers.  +/-25 Re is large enough for the empirical
! magnetosphere used by this event-level access calculation.
DOMAIN_X_MIN            -159280.0
DOMAIN_X_MAX             159280.0
DOMAIN_Y_MIN            -159280.0
DOMAIN_Y_MAX             159280.0
DOMAIN_Z_MIN            -159280.0
DOMAIN_Z_MAX             159280.0
R_INNER                  6371.2

#SPECTRUM
! Required by the common parser; not used by cutoff-rigidity tracing.
SPECTRUM_TYPE           POWER_LAW
SPEC_J0                 1.0
SPEC_GAMMA              2.0
SPEC_E0                 1000.0
SPEC_EMIN               1.0
SPEC_EMAX               2000.0

#OUTPUT_DOMAIN
! Global geodetic shell at POES altitude.  The runner transforms retained nodes
! to AACGM latitude and MLT at the exact snapshot epoch and extracts the
! per-MLT, per-hemisphere access boundary.  SHELL_GEOMETRY=GEODETIC follows the
! current Earth cutoff-test convention.
OUTPUT_MODE             SHELLS
SHELL_COUNT             1
SHELL_ALTS_KM           850.0
SHELL_LON_RES_DEG       15.0
SHELL_LAT_RES_DEG       2.0
SHELL_GEOMETRY          GEODETIC

#OUTPUT_OPTIONS
OUTPUT_COORDS           GEO

#NUMERICAL
DT_TRACE                0.2
ADAPTIVE_DT             T
MAX_STEPS               500000
MAX_TRACE_TIME          300.0
MAX_TRACE_DISTANCE      400.0
TRAP_DETECTION          T

!#END
