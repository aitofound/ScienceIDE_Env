@article{Winkel-2015-JCP,
	abstract = {This work introduces the high-order Boris-SDC method for integrating the equations of motion for electrically charged particles in electric and magnetic fields. Boris-SDC combines the Boris integrator with spectral deferred corrections (SDC), interpreted as a preconditioned Picard iteration for computing the stages of a collocation method. The second-order Boris Lorentz-force integrator, based on velocity-Verlet, serves as the SDC sweeper and preconditioner. The method provides a general way to extend the classical Boris integrator to high order. Its stability, convergence order, and conservation properties are demonstrated for several numerical configurations. Boris-SDC attains the expected high-order convergence for a single particle and for the center of mass of a particle cloud in a Penning trap, while exhibiting good long-term energy stability.},
	archiveprefix = {arXiv},
	author = {Winkel, Mathias and Speck, Robert and Ruprecht, Daniel},
	date-added = {2026-07-14 15:31:44 -0500},
