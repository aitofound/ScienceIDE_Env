@article{Rodriguez-2014-SW,
	abstract = {This work provides a relative intercalibration of the
               high-energy proton channels from the Energetic Particle
               Sensors flown on the Geostationary Operational Environmental
               Satellites since 1994. The method uses conditions associated
               with high solar-wind dynamic pressure, during which solar
               energetic proton fluxes become nearly isotropic at
               geostationary orbit because their rigidities exceed the
               geomagnetic cutoffs over the detectors' energy and angular
               responses. Observations from polar-orbiting and geostationary
               satellites during 1998--2013 are used to determine the
               relative responses of the proton detectors on GOES 8 through
               GOES 15. The channel responses generally agree within 20
               percent, and the resulting effect on the integral proton
               fluxes used for NOAA solar-radiation-storm alerts is less
               than 10 percent. The method can also be applied to detectors
               of different design when their broad energy-response
               functions are properly accounted for.},
	author = {Rodriguez, J. V. and Krosschell, J. C. and Green, J. C.},
