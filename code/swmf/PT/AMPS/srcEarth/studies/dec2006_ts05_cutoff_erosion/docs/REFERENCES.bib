@article{She-2026-SW,
	abstract = {Solar energetic particle events produce important space
               weather hazards at high altitudes and in polar regions.
               This study develops an empirical model of cutoff latitude
               for 1--100 MeV solar energetic protons in four magnetic
               local-time sectors using partial least squares regression.
               Cutoff latitudes are derived from zenith-looking proton
               measurements made by available Polar Orbiting Environmental
               Satellites and Meteorological Operational satellites during
               27 selected solar energetic particle events from 2012 to
               2024. The model uses the Kp, Dst, SYM-H, and AE geomagnetic
               indices; solar-wind dynamic pressure, interplanetary
               magnetic-field strength, and solar-wind speed; and the
               natural logarithm of proton kinetic energy as predictor
               variables. Piecewise linear regression of the partial least
               squares latent variables is used to represent cutoff
               behavior under quiet and disturbed conditions. The model
               generally performs better than previous cutoff-latitude
               models, particularly during extreme geomagnetic activity,
               and remains continuous and monotonic in proton energy,
               allowing cutoff energy or rigidity to be inferred for a
               specified invariant latitude.},
	author = {She, Zhenghao and Zhu, Hui and Song, Qian and Chen, Yao and Zhao, Yingying and Chen, Huicong and Qin, Zhijie},
	date-added = {2026-08-05 21:14:19 -0500},
