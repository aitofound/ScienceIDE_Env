! =============================================================================
! AMPS Earth validation C13: GRIDLESS MPI scheduler correctness
!
! run_C13.py renders this template once per model/scheduler/rank/chunk case.
! Every marked template token is required to be replaced before AMPS is launched. The
! runner also rejects proposed parser keywords that have caused earlier tests
! to terminate before tracing began.
!
! Scientific observable
! ---------------------
! Vertically incident proton cutoff rigidity is calculated over one global
! shell with PENUMBRA_SCAN.  The centered DIPOLE case is compared with the
! analytical Størmer cutoff.  DIPOLE and T05 products are then compared across
! GRIDLESS MPI schedulers, rank counts, and DYNAMIC chunk sizes.
! =============================================================================

#RUN_INFO
RUN_ID                         __RUN_ID__

#CALCULATION_MODE
CALC_TARGET                    CUTOFF_RIGIDITY
FIELD_EVAL_METHOD              GRIDLESS

#CUTOFF_RIGIDITY
! AMPS accepts energy limits in MeV/n.  The runner converts its requested
! proton rigidity bracket to these two values with the relativistic relation.
CUTOFF_EMIN                    __CUTOFF_EMIN_MEV__
CUTOFF_EMAX                    __CUTOFF_EMAX_MEV__
CUTOFF_MAX_PARTICLES           1
CUTOFF_NENERGY                 __CUTOFF_SCAN_N__

! VERTICAL is the parser-required sampling contract for cutoff searches.  A
! full sky map is intentionally not requested: C13 isolates inter-rank task
! scheduling while retaining a cutoff with an independent analytical solution.
CUTOFF_SAMPLING                VERTICAL
CUTOFF_SEARCH_ALGORITHM        PENUMBRA_SCAN
CUTOFF_UPPER_SCAN_N            __CUTOFF_SCAN_N__
CUTOFF_SCAN_SPACING            LINEAR
CUTOFF_TRACE_POLICY            ACCURATE
CUTOFF_BACKTRACE_CHARGE        REVERSED

! Resource exhaustion remains visible as UNRESOLVED output.  It may not be
! silently converted to physical shielding and must reproduce across schedules.
CUTOFF_TRACE_LIMIT_POLICY      UNRESOLVED
CUTOFF_MAX_TRAJ_TIME           __MAX_TRACE_TIME__

#PARTICLE_SPECIES
SPECIES                        PROTON
CHARGE                         1
MASS_AMU                       1.007276466621

#BACKGROUND_FIELD
! Replaced by a complete DIPOLE or T05 block.  T05 uses a checksum-recorded
! local copy of data/ts05_driver_C13.txt with the canonical DST header.
__FIELD_BLOCK__

#DOMAIN_BOUNDARY
! Bare AMPS lengths are kilometers.  A +/-35-Re box allows an unambiguous
! allowed exit while remaining identical in every scheduling case.
DOMAIN_X_MIN                  -222992.0
DOMAIN_X_MAX                   222992.0
DOMAIN_Y_MIN                  -222992.0
DOMAIN_Y_MAX                   222992.0
DOMAIN_Z_MIN                  -222992.0
DOMAIN_Z_MAX                   222992.0
R_INNER                        6371.2

#ELECTRIC_FIELD
! No electric field is configured.  C13 isolates magnetic backtracing.

#SPECTRUM
! The common parser requires a spectrum block, although cutoff tracing uses the
! bracket above rather than the differential intensity normalization.
SPECTRUM_TYPE                  POWER_LAW
SPEC_J0                        1.0
SPEC_GAMMA                     3.0
SPEC_E0                        100.0
SPEC_EMIN                      0.1
SPEC_EMAX                      20000.0

#OUTPUT_DOMAIN
! No GEODETIC geometry is requested.  The default spherical shell is defined
! directly in GSM, the coordinate system in which DIPOLE_TILT=0 aligns the
! magnetic axis with +Z.  This makes the output latitude the magnetic latitude
! required by the Størmer formula and avoids a GEO/WGS-84 -> GSM rotation.
OUTPUT_MODE                    SHELLS
SHELL_COUNT                    1
SHELL_ALTS_KM                  __SHELL_ALT_KM__
SHELL_LON_RES_DEG              __SHELL_LON_RES_DEG__
SHELL_LAT_RES_DEG              __SHELL_LAT_RES_DEG__

#OUTPUT_OPTIONS
OUTPUT_COORDS                  GSM

#NUMERICAL
DT_TRACE                       __DT_TRACE__
ADAPTIVE_DT                    T
MAX_STEPS                      __MAX_STEPS__
MAX_TRACE_TIME                 __MAX_TRACE_TIME__
MAX_TRACE_DISTANCE             __MAX_TRACE_DISTANCE_RE__
TRAP_DETECTION                 T

! These are the C13 variables under test.  The same values are also supplied on
! the command line so the archived deck and executable invocation are explicit.
GRIDLESS_MPI_SCHEDULER         __GRIDLESS_MPI_SCHEDULER__
GRIDLESS_MPI_DYNAMIC_CHUNK     __GRIDLESS_MPI_DYNAMIC_CHUNK__
GRIDLESS_PARALLEL              THREADS
GRIDLESS_THREADS               __GRIDLESS_THREADS__

!#END
