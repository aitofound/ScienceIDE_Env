! =============================================================================
! AMPS Earth validation C19A GRIDDED branch
! GOES-13/15 EPEAD east-west directional SEP-access validation
!
! This is a complete, runnable default input deck.  It represents GOES-13 at
! 2012-05-17 06:00 UTC and uses T05 on the standalone Mode3D mesh.  Before a
! manual run, place the user-supplied driver at:
!
!   srcEarth/test/C19/data/ts05_driver_may2012.txt
!
! and launch from srcEarth/test/C19 so the relative DRIVER_FILE and TRAJ_FILE
! paths below resolve. run_C19.py renders either one legacy case directory or one
! multi-snapshot batch directory per field model/search mode and changes named
! directives such as EPOCH, TEMPORAL_MODE, FIELD_MODEL, DRIVER_FILE, mesh controls,
! directional resolution, scheduler, and thread count. No macro or placeholder
! substitution is required.
! =============================================================================

#RUN_INFO
RUN_ID                         C19_gridded_t05_goes13_20120517T060000Z

#CALCULATION_MODE
CALC_TARGET                    CUTOFF_RIGIDITY
FIELD_EVAL_METHOD              GRID_3D

#CUTOFF_RIGIDITY
! Production C19 uses DIRECT_ACCESS: only the detector-response A(R,Omega)
! trajectories are traced.  PENUMBRA_SCAN remains available explicitly when full
! lower/effective/upper cutoff topology is needed.  Both modes preserve configured
! time/step/distance safety-limit outcomes as the third UNRESOLVED state.
CUTOFF_EMIN                    0.5
CUTOFF_EMAX                    500.0
CUTOFF_MAX_PARTICLES           1
CUTOFF_NENERGY                 120
CUTOFF_SAMPLING                VERTICAL
CUTOFF_SEARCH_ALGORITHM        DIRECT_ACCESS
CUTOFF_UPPER_SCAN_N            120
CUTOFF_SCAN_SPACING            LINEAR
CUTOFF_TRACE_POLICY            ACCURATE
CUTOFF_BACKTRACE_CHARGE        REVERSED
CUTOFF_TRACE_LIMIT_POLICY      UNRESOLVED
! run_C19.py fills this with the magnetic-access seed rigidity grid for BOTH
! GRIDDED and GRIDLESS.  In adaptive DIRECT_ACCESS this is deliberately a coarse
! grid spanning the complete positive detector-response support.  Every seed is
! evaluated in every selected sky direction; the solver then inserts geometric
! midpoint probes and recursively refines intervals whose endpoint states differ
! (including resolved<->UNRESOLVED boundaries).  An UNRESOLVED/UNRESOLVED interval
! stops after the guard probes because rigidity refinement cannot cure a trace budget.
! The detector response itself
! is integrated analytically in the Python fold, so internal response discontinuities
! do not need to be duplicated as mandatory trajectory nodes.
!
! PENUMBRA_SCAN ignores the adaptive switch below and uses this list only as its
! fixed-grid companion A(R,Omega) product, preserving the full diagnostic behavior.
CUTOFF_RIGIDITY_LIST_GV        0.174013525
! Adaptive DIRECT_ACCESS is the optimized C19 production path.  MAX_DEPTH limits
! recursive bisection of ambiguous intervals.  GUARD_DEPTH forces midpoint probes
! even when coarse endpoints agree; depth=1 probes every seed interval midpoint and
! helps expose narrow penumbral pockets before ambiguity-driven refinement begins.
CUTOFF_DIRECT_ACCESS_ADAPTIVE              T
CUTOFF_DIRECT_ACCESS_ADAPTIVE_MAX_DEPTH    6
CUTOFF_DIRECT_ACCESS_ADAPTIVE_GUARD_DEPTH  1
CUTOFF_MAX_TRAJ_TIME           300.0
! C19 resolves long-lived trajectories in stages instead of making every trajectory
! pay for a larger frozen-field trace.  Only TIME_LIMIT/STEP_LIMIT samples are retraced
! from the identical initial condition.  Two factor-of-two passes give 300 -> 600 ->
! 1200 s.  Samples still unresolved at the last pass remain UNRESOLVED; no timeout is
! ever relabelled as geomagnetic shielding.
CUTOFF_UNRESOLVED_EXTENSION_PASSES 2
CUTOFF_UNRESOLVED_EXTENSION_FACTOR 2.0
DIRECTIONAL_MAP                T
DIRMAP_LON_RES                 2.5
DIRMAP_LAT_RES                 2.5
! C19 production can restrict trajectory work to the union of the physical EAST
! and WEST detector apertures while retaining the exact same regular sky-grid cells
! and 2.5-degree angular resolution as FULL_SPHERE.  FULL_SPHERE remains available
! through the same input keyword or the corresponding CLI override.
! VECTOR_APERTURES is instrument-neutral: the runner writes the actual physical
! detector LOOK vectors into the file below. Batched rows carry LOCATION=<index>
! so Mode3D uses only the apertures belonging to each observation. Use
! DIRMAP_COVERAGE FULL_SPHERE to recover the complete historical sky.
DIRMAP_COVERAGE                VECTOR_APERTURES
DIRMAP_APERTURE_FILE           C19_directional_apertures.dat

#PARTICLE_SPECIES
SPECIES                        PROTON
CHARGE                         1
MASS_AMU                       1.007276466621

#BACKGROUND_FIELD
! The driver record at EPOCH overrides the parser-safe static values below.
FIELD_MODEL                    T05
! Explicit defaults are also used by the P0.9 centered-dipole Störmer anchor.
DIPOLE_MOMENT                  1.0
DIPOLE_TILT                    0.0
EPOCH                          2012-05-17T06:00:00
DRIVER_FILE                    data/ts05_driver_may2012.txt
DST                            -50.0
PDYN                           4.0
IMF_BX                         0.0
IMF_BY                         0.0
IMF_BZ                         -5.0
SW_VX                          -450.0
SW_N                           5.0
G1                             0.0
G2                             0.0
G3                             0.0
T05_W1                         0.0
T05_W2                         0.0
T05_W3                         0.0
T05_W4                         0.0
T05_W5                         0.0
T05_W6                         0.0

#MODE3D_MESH
MODE3D_MESH_RES_EARTH_RE       0.05
MODE3D_MESH_RES_BOUNDARY_RE    2.0
MODE3D_MESH_COARSENING         LINEAR
MODE3D_MESH_EXPONENT           1.0

#DOMAIN_BOUNDARY
! Bare lengths are kilometers.  The domain extends to +/-40 Earth radii.
DOMAIN_X_MIN                  -254848.0
DOMAIN_X_MAX                   254848.0
DOMAIN_Y_MIN                  -254848.0
DOMAIN_Y_MAX                   254848.0
DOMAIN_Z_MIN                  -254848.0
DOMAIN_Z_MAX                   254848.0
R_INNER                        6371.2

#SPECTRUM
! Required by the common parser.  P1.3 replaces SPEC_GAMMA for every observational
! case with the epoch-dependent spectrum selected by run_C19.py (OBSERVED_WEST by
! default, or an explicit FILE/FIXED sensitivity spectrum).  The postprocessor is
! authoritative for detector folding; these directives preserve complete input/provenance
! and keep the AMPS-side spectrum definition consistent with the case metadata.
SPECTRUM_TYPE                  POWER_LAW
SPEC_J0                        1.0
SPEC_GAMMA                     3.0
SPEC_E0                        100.0
SPEC_EMIN                      0.5
SPEC_EMAX                      500.0

#TEMPORAL
! SNAPSHOT is the legacy one-case behavior. run_C19.py changes this to
! SNAPSHOT_LIST for a GRIDDED batch and writes the explicit irregular observation
! epochs beside the deck. Unlike TIME_SERIES, SNAPSHOT_LIST filters the trajectory
! so only locations timestamped at the active field snapshot are evaluated.
TEMPORAL_MODE                  SNAPSHOT
SNAPSHOT_LIST_FILE             C19_snapshot_epochs.txt

#OUTPUT_DOMAIN
! The committed trajectory file contains the default GOES-13 sample. The runner
! creates either a one-line independent case or a stable multi-row batch trajectory
! and retains this same filename.
OUTPUT_MODE                    TRAJECTORY
TRAJ_FRAME                     GEO
TRAJ_FILE                      C19_trajectory.txt
FLUX_DT                        5.0

#OUTPUT_OPTIONS
OUTPUT_COORDS                  GEO

#NUMERICAL
DT_TRACE                       0.25
ADAPTIVE_DT                    T
MAX_STEPS                      500000
MAX_TRACE_TIME                 300.0
! 0 disables the cumulative path-length cap.  C19 intentionally lets the
! physical 300-s trace-time limit control all proton energies; a fixed path cap
! otherwise gives high-energy particles much less physical time to establish escape
! or trapping than low-energy particles.
MAX_TRACE_DISTANCE             0.0
TRAP_DETECTION                 T
! Supplement mirror/bounce trapping with a frozen-field drift-shell recurrence test.
! This is important for near-90-degree-pitch GEO trajectories that can circulate on
! a closed shell without producing enough clean v_parallel sign reversals.
TRAP_DRIFT_DETECTION           T
TRAP_MIN_DRIFT_REVOLUTIONS     3
TRAP_DRIFT_RADIAL_GROWTH_TOL_RE 1.0
TRAP_DRIFT_RADIAL_REL_TOL       0.20
TRAP_DRIFT_LATITUDE_TOL         0.20
TRAP_DRIFT_PITCH_COS2_TOL       0.25
! Additional secular-drift veto: even when the azimuth-resolved profiles match, a
! candidate trapped shell must not move its mean radial profile by more than 1 Re from
! one completed drift revolution to the next.  This gate can only reject a trap
! classification; it can never create a physical FORBIDDEN state.
TRAP_DRIFT_MAX_MEAN_RADIUS_CHANGE_RE 1.0
TRAP_DRIFT_PROFILE_BINS         24
TRAP_DRIFT_MIN_PROFILE_COVERAGE 0.70
TRAP_DRIFT_MIN_MATCHED_BIN_FRACTION 0.75
! Keep the momentum gate deliberately strict until Phase-0 diagnostics demonstrate
! the actual long-trace RK4 |p| spread.  Relaxing this value must be a documented
! convergence choice, not a hidden way to make the trap classifier fire.
TRAP_ENERGY_REL_TOL             1.0e-4
MODE3D_MPI_SCHEDULER           DYNAMIC
MODE3D_MPI_DYNAMIC_CHUNK       16
MODE3D_PARALLEL                THREADS
MODE3D_THREADS                 16

!#END
