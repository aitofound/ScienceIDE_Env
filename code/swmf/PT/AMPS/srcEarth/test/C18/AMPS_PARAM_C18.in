! =============================================================================
! AMPS Earth validation C18
! Deterministic POSIX-thread background-field initialization in standalone Mode3D
!
! run_C18.py renders one copy for each magnetic model and launches:
!   1. a serial field-initialization / serial cutoff baseline; and
!   2. POSIX-thread field initialization with 1,2,4,8,16 temporary workers while
!      retaining a serial cutoff calculation to isolate the initialization stage.
!
! No checked-in numerical reference is used.  The serial result generated by the
! same executable, MPI decomposition, input, and mesh is the runtime baseline.
! =============================================================================

#CALCULATION_MODE
CALC_TARGET             CUTOFF_RIGIDITY
FIELD_EVAL_METHOD       GRID_3D

#CUTOFF_RIGIDITY
! The exact-rigidity product is deliberately small.  C18 is a determinism test,
! not a new physical cutoff benchmark.  Existing C6/C7/C9/C10 tests cover model
! accuracy against external/reference data.
CUTOFF_EMIN             __CUTOFF_EMIN_MEV__
CUTOFF_EMAX             __CUTOFF_EMAX_MEV__
CUTOFF_MAX_PARTICLES    1
CUTOFF_NENERGY          24
CUTOFF_SAMPLING         VERTICAL
CUTOFF_SEARCH_ALGORITHM RIGIDITY_LIST
CUTOFF_RIGIDITY_LIST_GV __RIGIDITY_LIST_GV__
CUTOFF_ACCESS_ABS_LAT_MIN __ACCESS_LAT_MIN_DEG__
CUTOFF_ACCESS_ABS_LAT_MAX __ACCESS_LAT_MAX_DEG__
CUTOFF_TRACE_POLICY     ACCURATE
CUTOFF_BACKTRACE_CHARGE REVERSED
CUTOFF_TRACE_LIMIT_POLICY FORBIDDEN
CUTOFF_MAX_TRAJ_TIME    __MAX_TRACE_TIME_S__

#PARTICLE_SPECIES
SPECIES                 PROTON
CHARGE                  1
MASS_AMU                1.007276466621

#BACKGROUND_FIELD
FIELD_MODEL             __FIELD_MODEL__
EPOCH                   __EPOCH__

! DIPOLE control parameters.
DIPOLE_MOMENT           1.0
DIPOLE_TILT             0.0

! Fixed disturbed-state empirical-model parameters.  These correspond to the
! 2006-12-15 03:05 UTC C9 TS05 driver record.  Unused model-specific values are
! harmless and keep every rendered deck structurally identical.
DST                     -177.0
PDYN                    2.89
IMF_BX                  5.31
IMF_BY                  11.76
IMF_BZ                  -10.50
SW_VX                   -799.8
SW_N                    2.32
G1                      0.0
G2                      0.0
G3                      0.0
T05_W1                  3.11
T05_W2                  1.88
T05_W3                  2.96
T05_W4                  6.61
T05_W5                  4.83
T05_W6                  4.88

#MODE3D_MESH
! Coarse but nontrivial mesh: sufficient to distribute many field evaluations
! among all requested workers while keeping the initialized-field dump practical.
MODE3D_MESH_RES_EARTH_RE     __MESH_RES_EARTH_RE__
MODE3D_MESH_RES_BOUNDARY_RE  __MESH_RES_BOUNDARY_RE__
MODE3D_MESH_COARSENING       __MESH_COARSENING__
MODE3D_MESH_EXPONENT         __MESH_EXPONENT__

#DOMAIN_BOUNDARY
DOMAIN_X_MIN            -__DOMAIN_HALF_SIZE_KM__
DOMAIN_X_MAX             __DOMAIN_HALF_SIZE_KM__
DOMAIN_Y_MIN            -__DOMAIN_HALF_SIZE_KM__
DOMAIN_Y_MAX             __DOMAIN_HALF_SIZE_KM__
DOMAIN_Z_MIN            -__DOMAIN_HALF_SIZE_KM__
DOMAIN_Z_MAX             __DOMAIN_HALF_SIZE_KM__
R_INNER                  6371.2

#SPECTRUM
! Required by the common parser; not used by cutoff-rigidity tracing.
SPECTRUM_TYPE           POWER_LAW
SPEC_J0                 1.0
SPEC_GAMMA              2.0
SPEC_E0                 1000.0
SPEC_EMIN               1.0
SPEC_EMAX               2000.0

#OUTPUT_DOMAIN
OUTPUT_MODE             SHELLS
SHELL_COUNT             1
SHELL_ALTS_KM           __SHELL_ALT_KM__
SHELL_LON_RES_DEG       __SHELL_LON_RES_DEG__
SHELL_LAT_RES_DEG       __SHELL_LAT_RES_DEG__
SHELL_GEOMETRY          GEODETIC

#OUTPUT_OPTIONS
OUTPUT_COORDS           GEO

#NUMERICAL
DT_TRACE                __DT_TRACE_S__
ADAPTIVE_DT             T
MAX_STEPS               __MAX_STEPS__
MAX_TRACE_TIME          __MAX_TRACE_TIME_S__
MAX_TRACE_DISTANCE      __MAX_TRACE_DISTANCE_RE__
TRAP_DETECTION          T

!#END
