$OS eq "Linux" and $Compiler eq "f95"
	${COMPILE.f77} ${Cflag0} -132 collisionPW_planet.f

$OS eq "Darwin" and $Compiler eq "f95"
	${COMPILE.f77} ${Cflag1} -132 PhotoElectronPW_planet.f
	${COMPILE.f77} ${Cflag1} -132 IonHeatFluxPW_planet.f
	${COMPILE.f77} ${Cflag1} -132 collisionPW_planet.f
	${COMPILE.f77} ${Cflag1} -132 precipitationPW_planet.f
	${COMPILE.f77} ${Cflag1} -132 glowex_planet.f
	${COMPILE.f77} ${Cflag1} -132 eHeatFluxPW.f
	${COMPILE.f77} ${Cflag1} -132 startupPW_planet.f
	${COMPILE.f77} ${Cflag1} -132 ssflux_planet.f

$Compiler eq "gfortran" and `gfortran -dumpversion` =~ /^1\d/
	${COMPILE.f90} ${Cflag3} -fallow-argument-mismatch ModParticle.f90
	${COMPILE.f90} ${Cflag3} -fallow-argument-mismatch ModMpiPwomInterfaces.f90

# With NAG f95 ModMpiInterface compiles with -dusty only because
# the same MPI routines are called with different argument types
$Compiler eq "f95" or $Compiler eq "nagfor"
	${COMPILE.f90} ${Cflag2}  -dusty ModMpiPwomInterfaces.f90
	${COMPILE.f90} ${Cflag2}  -dusty ModParticle.f90

