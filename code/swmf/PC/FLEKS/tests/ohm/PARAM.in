#DESCRIPTION
Hybrid PIC whistler wave test exercising the full generalized Ohm's law
(convection, Hall, resistive eta*J, and electron pressure gradient grad Pe).

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-3.2                    xMin
 3.2                    xMax
-0.05                   yMin
 0.05                   yMax
-0.05                   zMin
 0.05                   zMax

#NCELL
64                      nCellX
1                       nCellY
1                       nCellZ

#MAXBLOCKSIZE
64                      maxBlockSizeX
1                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#RESISTIVITY
2.0e9                   etaResistivity  [m^2/s]

#ELECTRONTEMPERATURE
20.0                    electronTemperature  [eV]
1.0                     electronGamma
1.0                     electronDensity0

#BSUBCYCLE
4                       nBSubcycle

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
5.0                     rho [amu/cc]
0.0                     ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
10000.0                 T [K]
1.0439e-8               bx [T]          Guide field Bx0
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#TESTCASE
HybridWave

#TIMESTEPPING
T                       useFixedDt
0.02                    dt

#NORMALIZATION
1.0e5                   lNormSI   [m]
1.0e5                   uNormSI   [m/s]

#MONITOR
50                      dnReport

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#PARTICLES
2000                    nParticle per cell in X
1                       nParticle per cell in Y
1                       nParticle per cell in Z

#COMOVING
F                       solvePartInCoMov
0                       nSmoothBackGroundU

#UPWINDE
F                       useUpwindE
0.0                     limiterThetaE

#UPWINDB
F                       doSmoothB
0.0                     theta

#SAVEPLOT
1                       nPlot
z=0 fluid ascii pic     plotString
-1                      dn
6.25                    dt
1                       dx
Bx By Bz Ex Ey Ez       varName

#STOP
-1                      MaxIter
6.25                    TimeMax

#RUN

#AVGFIELDB
T                       useAvgFieldB
20                      nAvgFieldB
