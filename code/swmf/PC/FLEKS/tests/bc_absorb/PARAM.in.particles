#DESCRIPTION
Absorbing-particle boundary-condition test: ions with bulk +x flow drain out through the absorbing x walls (particles removed + tallied on exit).

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-3.2                    xMin
 3.2                    xMax
-0.05                   yMin
 0.05                   yMax
-0.05                   zMin
 0.05                   zMax

#NCELL
8                       nCellX
1                       nCellY
1                       nCellZ

#MAXBLOCKSIZE
16                      maxBlockSizeX
1                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDBOXBOUNDARY
absorb                  fieldBoxBoundaryLo
absorb                  fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi

#PARTICLEBOXBOUNDARY
0                       iSpecies
absorb                  particleBoxBoundaryLo
absorb                  particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi

#RESAMPLING
F                       doReSampling

#SOLVEEM
F                       solveEM

#HYBRIDPIC
F                       useHybridPIC

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
5.0                     rho
40.0                    ux
0.5                     uy
0.0                     uz
0.0                     T
0.0                     bx
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#TIMESTEPPING
T                       useFixedDt
0.02                    dt

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#MONITOR
200                     dnReport

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#PARTICLES
100                     npcelx
1                       npcely
1                       npcelz

#SAVEPLOT
1                       nPlot
z=0 var ascii planet    plotString
-1                      dn
20.0                    dt
1                       dx
rhoS0 uxS0 uyS0 uzS0 Bx By Bz Ex Ey Ez   plotVar

#STOP
-1                      MaxIter
20.0                    TimeMax

#RUN
