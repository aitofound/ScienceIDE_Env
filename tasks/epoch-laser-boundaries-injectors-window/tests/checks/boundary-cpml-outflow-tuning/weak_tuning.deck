begin:constant
  x0 = -2.0 * micron
  w0 = 0.5 * micron
  lambda0 = 0.4 * micron
  amp0 = 1.0e10
end:constant


begin:control
  nx = 250
  t_end = 30 * femto
  x_min = -5 * micron
  x_max = 5 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = cpml_outflow
  # Deliberately weakened CPML tuning (deck_boundaries_block.f90's
  # cpml_thickness/cpml_kappa_max/cpml_a_max/cpml_sigma_max keywords, never
  # varied from their compiled-in defaults by any other check --
  # comment/coverage-ledger.md): a smaller absorption-profile maximum
  # conductivity/scaling (cpml_sigma_max, cpml_a_max) and a thinner,
  # less-refracting-index-matched layer (cpml_kappa_max closer to 1,
  # cpml_thickness fewer cells) are standard CPML/FDTD results
  # (Roden & Gedney 2000) for weaker absorption -- this deck's residual
  # energy after the packet reaches the wall must therefore be
  # measurably WORSE (higher) than default_tuning.deck's, proving these
  # four keywords are actually read and applied, not silently ignored in
  # favour of the compiled-in defaults.
  cpml_thickness = 3
  cpml_kappa_max = 2.0
  cpml_a_max = 0.02
  cpml_sigma_max = 0.05
end:boundaries


begin:fields
  ey = amp0 * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
  bz = (amp0 / c) * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
end:fields


begin:output
  dt_snapshot = 30 * femto
  dump_last = T

  grid = always
  ey = always
  bz = always
end:output
