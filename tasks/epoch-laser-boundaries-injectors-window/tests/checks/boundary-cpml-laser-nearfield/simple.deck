begin:control
  nx = 150
  t_end = 15 * femto
  x_min = -3 * micron
  x_max = 3 * micron
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  amp = 2.0e11
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 1 * femto
  dump_last = T

  grid = always
  ey = always
end:output
