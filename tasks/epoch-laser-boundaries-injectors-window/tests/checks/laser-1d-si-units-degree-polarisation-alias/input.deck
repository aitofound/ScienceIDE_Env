begin:control
  nx = 100
  t_end = 20 * femto
  x_min = -2 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  # SI (W/m^2) amplitude alias: deck_laser_block.f90's
  # 'irradiance'/'intensity' branch, working_laser%amp =
  # SQRT(value/(c*epsilon0/2)) -- the SAME formula as intensity_w_cm2
  # (laser-1d-simple-open-gauss-upstream) minus that branch's extra *100,
  # a genuinely distinct code path never independently executed before
  # this row (deck_laser_block.f90:126-130).
  intensity = 1.0e19
  # Degrees alias: deck_laser_block.f90's 'pol'/'polarisation' branch,
  # working_laser%pol_angle = pi*value/180 -- distinct from pol_angle's
  # direct-radians assignment (laser-1d-polarisation-energy-invariant),
  # never independently executed before this row (deck_laser_block.f90:
  # 241-247).
  polarisation = 30.0
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 1 * femto
  dump_last = T

  grid = always
  ey = always
  ez = always
end:output
