begin:control
  nx = 100
  t_end = 15 * femto
  x_min = 0
  x_max = 1 * micron
end:control


begin:boundaries
  bc_x_min = simple_outflow
  bc_x_max = simple_outflow
end:boundaries


begin:species
  # A spatially uniform, unbounded (constant-expression) density: unlike
  # every other move_window=T check in this leaf (which deliberately use
  # number_density=0 to keep the shift-cadence/bc-switch observables
  # uncoupled from particle bookkeeping), insert_particles/remove_particles
  # here have real weight/momentum work to do every shift event.
  # nparticles_per_cell=4.5 gives species%npart_per_cell a nonzero
  # fractional part, so insert_particles' 'place extra particle based on
  # probability' branch (window.F90:204-208, IF (random() < npart_frac)
  # n_frac=1) fires on every one of the ~hundreds of shift events this
  # deck produces, landing 4 or 5 macroparticles per inserted cell with
  # near-50/50 probability. temperature=0 makes momentum_from_temperature()
  # return drift_px exactly (Box-Muller with stdev=0), independent of which
  # outcome the probability branch takes, so px stays an exact invariant
  # even though particle COUNT is stochastic (EPOCH's own deterministic
  # default seed, constants.f90/setup.F90 seed=7842432+rank unless
  # use_random_seed=T, which this deck leaves at its default .FALSE., makes
  # the count sequence itself reproducible between two runs of this same
  # pinned binary+deck). drift_px is kept small enough (~0.11 micron/ps,
  # i.e. ~0.7 nm over this deck's full 15 fs) that bulk particle motion is
  # negligible next to dx=10 nm, so it does not itself disturb the
  # steady-state density this check's weight invariant relies on -- it is
  # present only to exercise insert_particles' drift(:) evaluation
  # (window.F90:200-201) with a genuinely nonzero value.
  name = Plasma
  charge = -1
  mass = 1.0
  temperature = 0
  drift_px = 1.0e-25
  number_density = 1.0e20
  nparticles_per_cell = 4.5
end:species


begin:window
  move_window = T
  window_start_time = 0
  window_v_x = c / 2
  bc_x_min_after_move = simple_outflow
  bc_x_max_after_move = simple_outflow
end:window


begin:output
  dt_snapshot = 1 * femto
  dump_last = T

  grid = always
  particles = always
  px = always
  particle_weight = always
end:output
