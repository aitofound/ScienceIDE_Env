begin:control
  nx = 100
  t_end = 15 * femto
  x_min = 0
  x_max = 1 * micron
end:control


begin:boundaries
  bc_x_min = simple_outflow
  bc_x_max = simple_outflow
end:boundaries


begin:window
  move_window = T
  window_start_time = 0
  window_v_x = c / 2
  bc_x_min_after_move = simple_outflow
  bc_x_max_after_move = simple_outflow
end:window


begin:output
  dt_snapshot = 1 * femto
  dump_last = T

  grid = always
end:output
