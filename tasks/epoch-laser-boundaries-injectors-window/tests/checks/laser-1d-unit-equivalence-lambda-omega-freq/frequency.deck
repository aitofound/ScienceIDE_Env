begin:control
  nx = 100
  t_end = 20 * femto
  x_min = -2 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  amp = 5.0e11
  # 'frequency' is the SI cycles/s key (deck_laser_block.f90:162,
  # omega_func_type=c_of_freq); laser_update_omega then multiplies by
  # 2*pi (laser.f90: 'IF (omega_func_type==c_of_freq) omega = 2*pi*omega'),
  # a distinct code branch and evaluation order from both 'omega'/'freq'
  # (value used directly) and 'lambda' (omega=2*pi*c/lambda).
  frequency = c / (0.8 * micron)
end:laser


begin:output
  dt_snapshot = 2 * femto
  dump_last = T

  grid = always
  ey = always
end:output
