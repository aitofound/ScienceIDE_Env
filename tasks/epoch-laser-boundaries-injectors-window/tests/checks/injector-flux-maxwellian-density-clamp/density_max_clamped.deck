begin:control
  nx = 100
  t_end = 100 * femto
  x_min = 0
  x_max = 30 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = open
end:boundaries


begin:species
  name = Beam
  charge = -1
  mass = 1.0
  number_density = 0
end:species


begin:injector
  boundary = x_min
  species = Beam
  # A spatially-uniform density (2e20/m^3) permanently above density_max
  # (1e20/m^3): injectors.F90 run_single_injector()'s per-particle
  # 'density = MIN(density, injector%density_max); new%weight =
  # weight_fac*density' clamp fires for every created particle, so every
  # macroparticle's weight must equal weight_fac*density_max =
  # (dx/npart_per_cell)*density_max EXACTLY -- not weight_fac*2e20, the
  # density function's own (unclamped) value. Note npart_ideal (hence the
  # stochastic particle COUNT) depends only on npart_per_cell/v_inject/dt,
  # never on the density function itself, so this clamp is visible purely
  # in per-particle weight, independent of count-noise.
  number_density = 2.0e20
  density_max = 1.0e20
  temperature = 0
  drift_px = 2.0e-22
  nparticles_per_cell = 50
end:injector


begin:output
  dt_snapshot = 100 * femto
  dump_last = T

  particles = always
  px = always
  particle_weight = always
end:output
