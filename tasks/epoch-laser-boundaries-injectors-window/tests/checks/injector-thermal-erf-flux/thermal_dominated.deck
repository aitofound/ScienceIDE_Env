begin:control
  nx = 100
  t_end = 100 * femto
  x_min = 0
  x_max = 30 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = open
end:boundaries


begin:species
  name = Beam
  charge = -1
  mass = 1.0
  number_density = 0
end:species


begin:injector
  boundary = x_min
  species = Beam
  # drift_px=0 exactly selects injectors.F90 run_single_injector()'s
  # 'ABS(p_drift) < p_therm*1e-9' near-zero-drift branch (density_correction
  # =0.5, v_inject_s=2/sqrt(2*pi)*p_therm), distinct from
  # injector-flux-density-drift's large-drift branch (density_correction=
  # 1.0). Because flux_dir_cell stays set (not reset to -1 as in the
  # large-drift branch), the per-particle x-momentum at creation is drawn
  # from particle_temperature.F90's flux_momentum_from_temperature(), which
  # for near-zero drift falls through to its own 'ELSE' branch: a Rayleigh
  # distribution direction*SQRT(mom1^2+mom2^2), mom1,mom2~N(0,sigma) -- the
  # SAME formula boundary-thermal-heat-bath-stats validates for particle_bcs'
  # thermal reinjection, here exercised at the INJECTOR boundary instead.
  # Density kept low (1e15/m^3, vs injector-flux-density-drift's 1e20/m^3)
  # to keep this deck's self-field a negligible perturbation on the
  # momentum-distribution comparison.
  number_density = 1.0e15
  temperature_ev = 5.0
  drift_px = 0.0
  nparticles_per_cell = 200
end:injector


begin:output
  dt_snapshot = 100 * femto
  dump_last = T

  particles = always
  px = always
  py = always
  pz = always
  particle_weight = always
end:output
