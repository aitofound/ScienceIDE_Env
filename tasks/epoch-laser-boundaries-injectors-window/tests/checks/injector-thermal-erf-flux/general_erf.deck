begin:control
  nx = 100
  t_end = 100 * femto
  x_min = 0
  x_max = 30 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = open
end:boundaries


begin:species
  name = Beam
  charge = -1
  mass = 1.0
  number_density = 0
end:species


begin:injector
  boundary = x_min
  species = Beam
  # drift_px comparable in magnitude to the thermal momentum (p_ratio =
  # drift_px/(sqrt(2)*p_therm) = 1/sqrt(2)) selects injectors.F90
  # run_single_injector()'s GENERAL branch (neither the large-drift nor the
  # near-zero-drift special case): density_correction = 0.5*(1+erf_func(
  # p_ratio)) using the source's own polynomial erf_func() approximation
  # (housekeeping/utilities.f90), and v_inject_s = p_drift +
  # (1/sqrt(2*pi))*p_therm*EXP(-p_ratio**2)/density_correction. This is the
  # one injector flux branch never independently driven by any check
  # before this row (comment/coverage-ledger.md).
  number_density = 1.0e15
  temperature_ev = 5.0
  drift_px = 8.542493293635336e-25
  nparticles_per_cell = 200
end:injector


begin:output
  dt_snapshot = 100 * femto
  dump_last = T

  particles = always
  px = always
  particle_weight = always
end:output
