begin:control
  nx = 24
  ny = 24
  nz = 24

  t_end = 15 * femto

  x_min = -1.5 * micron
  x_max = -x_min
  y_min = x_min
  y_max = x_max
  z_min = x_min
  z_max = x_max

  stdout_frequency = 20
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = periodic
  bc_y_max = periodic
  bc_z_min = periodic
  bc_z_max = periodic
end:boundaries


begin:laser
  boundary = x_min
  amp = 2.0e11
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 0.3 * femto
  dump_last = T

  grid = always
  ey = always
end:output
