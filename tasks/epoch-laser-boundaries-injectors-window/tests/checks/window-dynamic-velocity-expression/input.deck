begin:constant
  v0 = c / 4.0
  # Linear ramp: window_v_x(t) = v0 + k*time, reaching 3*c/4 by t_end=15fs.
  k = (0.75 * c - v0) / (15 * femto)
end:constant


begin:control
  nx = 100
  t_end = 15 * femto
  x_min = 0
  x_max = 1 * micron
end:control


begin:boundaries
  bc_x_min = simple_outflow
  bc_x_max = simple_outflow
end:boundaries


begin:window
  move_window = T
  window_start_time = 0
  # Time-varying window_v_x expression: deck_window_block.f90 tokenizes
  # this into window_v_x_stack and sets use_window_stack=
  # window_v_x_stack%is_time_varying (.TRUE. here, since the expression
  # depends on 'time'), so window.F90 moving_window() re-evaluates
  # 'window_v_x = evaluate(window_v_x_stack, errcode)' on EVERY call for
  # the rest of the run -- distinct from every other move_window=T check
  # in this leaf, which uses a constant window_v_x (evaluated once at
  # deck-parse time, use_window_stack left .FALSE.).
  window_v_x = v0 + k * time
  bc_x_min_after_move = simple_outflow
  bc_x_max_after_move = simple_outflow
end:window


begin:output
  dt_snapshot = 1 * femto
  dump_last = T

  grid = always
end:output
