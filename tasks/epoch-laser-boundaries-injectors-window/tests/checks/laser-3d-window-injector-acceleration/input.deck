begin:control
  nx = 48
  ny = 48
  nz = 48

  t_end = 20 * femto

  x_min = -2 * micron
  x_max = 2 * micron
  y_min = -1 * micron
  y_max = 1 * micron
  z_min = -1 * micron
  z_max = 1 * micron

  stdout_frequency = 20
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = simple_outflow
  bc_y_min = periodic
  bc_y_max = periodic
  bc_z_min = periodic
  bc_z_max = periodic
end:boundaries


begin:window
  move_window = T
  window_start_time = 6 * femto
  window_v_x = c / 2
  bc_x_min_after_move = simple_outflow
  bc_x_max_after_move = simple_outflow
end:window


begin:laser
  boundary = x_min
  amp = 2.0e11
  lambda = 0.6 * micron
end:laser


begin:species
  name = Beam
  charge = -1
  mass = 1.0
  number_density = 0
end:species


begin:injector
  boundary = x_max
  species = Beam
  number_density = 1.0e20
  temperature = 0
  drift_px = -2.0e-22
  nparticles_per_cell = 20
end:injector


begin:output
  # lambda=0.6*micron gives an analytic period T=lambda/c=2fs (see
  # ANALYTIC_PERIOD in validate.py). dt_snapshot must resolve this period
  # to let _measure_period() find zero crossings via linear interpolation
  # -- 2fs (==T) was an aliasing choice (~1 sample/period, indistinguishable
  # from DC), the same defect the sibling laser-3d-wavelength-smoke check
  # avoids with dt_snapshot=0.3fs for its 0.8micron/2.667fs-period laser
  # (~9 samples/period). 0.2fs gives ~10 samples/period here, matching that
  # established ratio, while still landing 3 whole periods (6fs) of
  # pre-window-start (window_start_time=6fs) samples for the >=3-crossings
  # gate.
  dt_snapshot = 0.2 * femto
  dump_last = T

  grid = always
  ey = always

  particles = always
  px = always
  particle_weight = always
end:output
