begin:control
  nx = 150
  t_end = 40 * femto
  x_min = -3 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  # No t_profile: use_time_function stays .FALSE., so laser_time_profile()
  # falls back to custom_laser_time_profile(), which every dimension tier's
  # code/epoch/epoch{1,2,3}d/src/user_interaction/custom_laser.f90 defines
  # as the constant 1.0_num (no ramp/decay envelope).
  boundary = x_min
  amp = 3.0e11
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 2 * femto
  dump_last = T

  grid = always
  ey = always
end:output
