{
  "binary": "bin/epoch2d",
  "dimension": "2d",
  "invariant": {
    "kind": "particle-offset-assembly",
    "params": {
      "runs": {
        "parallel": "parallel",
        "serial": "serial"
      },
      "species": [
        "electron",
        "ion"
      ]
    }
  },
  "runs": {
    "parallel": {
      "deck": "deck/parallel.deck",
      "decomposition": {
        "nprocx": 3,
        "nprocy": 2
      },
      "ranks": 6,
      "timeout_seconds": 900
    },
    "serial": {
      "deck": "deck/serial.deck",
      "decomposition": "auto",
      "ranks": 1,
      "timeout_seconds": 900
    }
  },
  "schema": "epoch-mdpc-run/v1"
}
