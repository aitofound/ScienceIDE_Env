<comment>
check = SR-MHD 3-D CT direct workload, one fast mode (contract override problem/wave_flag=0);
note  = the check directory name is historical: this deck is not a seven-wave workload
label = the acceleration label is workload metadata only; no speedup is claimed
configure = --prob=gr_linear_wave -s -b --coord=cartesian --flux=hlld

<job>
problem_id = sr_mhd_acceleration

<output1>
file_type   = tab
variable    = prim
data_format = %24.16e
dt          = 0.1

<output2>
file_type   = tab       # native face-centered magnetic field (outputs.cpp variable=b -> B1,B2,B3)
variable    = b
data_format = %24.16e
dt          = 0.1

<time>
cfl_number = 0.3
tlim       = 0.1
integrator = vl2
xorder     = 2
ncycle_out = 0

<mesh>
nx1 = 128
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 64
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 64
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<hydro>
gamma = 1.3333333333333333

<problem>
wave_flag = 0
amp = 1.0e-6
compute_error = false
rho = 4.0
pgas = 1.0
vx = 0.1
vy = 0.3
vz = -0.05
Bx = 2.5
By = 1.8
Bz = -1.2
