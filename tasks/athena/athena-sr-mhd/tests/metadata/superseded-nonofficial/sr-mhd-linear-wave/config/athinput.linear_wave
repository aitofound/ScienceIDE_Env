<comment>
check = SR-MHD seven-wave breadth; derived observables retain Bcc and CT/recovery evidence
configure = --prob=gr_linear_wave -s -b --coord=cartesian --flux=hlld

<job>
problem_id = sr_mhd_check_linear

<output1>
file_type   = tab
variable    = prim
data_format = %24.16e
dt          = 0.02

<time>
cfl_number = 0.3
tlim       = 0.02
integrator = vl2
xorder     = 2
ncycle_out = 0

<mesh>
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 4
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 4
nx3 = 4

<hydro>
gamma = 1.3333333333333333

<problem>
wave_flag = 3
amp = 1.0e-6
compute_error = false
rho = 1.0
pgas = 0.5
vx = 0.1
vy = 0.15
vz = 0.05
Bx = 1.0
By = 0.6666666666666666
Bz = 0.3333333333333333
