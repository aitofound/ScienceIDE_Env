<comment>
problem   = 3-D Jeans linear wave with self-gravity
reference = upstream deck inputs/hydro/athinput.jeans_3d, settings of tst/regression/scripts/tests/grav/unstable_jeans_3d_fft.py
configure = -fft --prob=jeans --grav=fft

<job>
problem_id = jeans_unstable_r16

<output1>
file_type   = tab       # the graded state
variable    = cons      # conserved variables
data_format = %24.16e   # full double precision
dt          = 0.046    # one dump at t = 0 and the forced dump at the end time
ghost_zones = false

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 100000     # cycle limit
tlim       = 0.046     # time limit
integrator = vl2        # time integration algorithm
xorder     = 2          # order of spatial reconstruction
ncycle_out = 0          # no per-cycle stdout

<mesh>
nx1        = 32      # Number of zones in X1-direction
x1min      = 0.0        # minimum value of X1
x1max      = 1.0        # maximum value of X1
ix1_bc     = periodic   # inner-X1 boundary flag
ox1_bc     = periodic   # outer-X1 boundary flag

nx2        = 16      # Number of zones in X2-direction
x2min      = 0.0        # minimum value of X2
x2max      = 0.5        # maximum value of X2
ix2_bc     = periodic   # inner-X2 boundary flag
ox2_bc     = periodic   # outer-X2 boundary flag

nx3        = 16      # Number of zones in X3-direction
x3min      = 0.0        # minimum value of X3
x3max      = 0.5        # maximum value of X3
ix3_bc     = periodic   # inner-X3 boundary flag
ox3_bc     = periodic   # outer-X3 boundary flag

<meshblock>
nx1        = 16
nx2        = 16
nx3        = 16

<hydro>
gamma           = 1.666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.00           # equivalent to sqrt(gamma*p/d) for p=0.1, d=1

<gravity>
mgmode          = FMG   # full multigrid, then multigrid iteration (multigrid solver only)
threshold       = 0.0   # automatic convergence control (multigrid solver only)
ix1_bc          = periodic
ox1_bc          = periodic
ix2_bc          = periodic
ox2_bc          = periodic
ix3_bc          = periodic
ox3_bc          = periodic

<problem>
amp             = 1.e-6
njeans          = 1.5
compute_error   = true
