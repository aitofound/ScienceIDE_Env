<comment>
problem   = FFT-driven Ornstein-Uhlenbeck turbulence in 3-D
reference = upstream deck inputs/hydro/athinput.turb, settings of tst/regression/scripts/tests/turb/turb_3d.py
configure = -fft --prob=turb   (and -mpi -fft for the MPI build)

<job>
problem_id = turb       # overridden per launch by run.sh

<output1>
file_type   = tab       # the graded state
variable    = cons      # conserved variables
data_format = %24.16e   # full double precision
dcycle      = 32        # dumps at cycle 0 and at the end of the window; must equal time/nlim
ghost_zones = false

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 32         # THE WINDOW: the run stops after exactly this many cycles
tlim       = 100.0      # unreachable, so nlim always ends the run
integrator = vl2        # time integration algorithm
xorder     = 2          # order of spatial reconstruction
ncycle_out = 0          # no per-cycle stdout

<mesh>
nx1        = 32         # Number of zones in X1-direction
x1min      = -0.5       # minimum value of X1
x1max      = 0.5        # maximum value of X1
ix1_bc     = periodic   # inner-X1 boundary flag
ox1_bc     = periodic   # outer-X1 boundary flag

nx2        = 16         # Number of zones in X2-direction
x2min      = -0.5       # minimum value of X2
x2max      = 0.5        # maximum value of X2
ix2_bc     = periodic   # inner-X2 boundary flag
ox2_bc     = periodic   # outer-X2 boundary flag

nx3        = 16         # Number of zones in X3-direction
x3min      = -0.5       # minimum value of X3
x3max      = 0.5        # maximum value of X3
ix3_bc     = periodic   # inner-X3 boundary flag
ox3_bc     = periodic   # outer-X3 boundary flag

refinement = none

<meshblock>
nx1        = 16
nx2        = 16
nx3        = 16

<hydro>
gamma           = 1.666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.00           # equivalent to sqrt(gamma*p/d) for p=0.1, d=1

<turbulence>
turb_flag  = 3    # continuously driven turbulence with OU smoothing
dedt       = 1.000000000000001  # energy injection rate
nlow       = 0    # cut-off wavenumber at low-k
nhigh      = 16   # cut-off wavenumber at high-k
expo       = 2.0  # power-law exponent
tcorr      = 0.1  # correlation time for the OU process
dtdrive    = 0.1  # time interval between perturbations (impulsive driving only)
f_shear    = 0.5  # the ratio of the shear component
rseed      = 1    # non-negative: one global random stream, independent of the rank layout
