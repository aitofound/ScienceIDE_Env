begin:constant

  dl = 7.4e-10

end:constant

begin:control

  x_min = 0.0
  x_max = 100*dl
  nx = 5
  # nsteps is a defensive hard iteration backstop only (t_end binds
  # first under this row's own CFL-limited dt; see
  # comment/self-validation.md's "Runtime calibration (compat-C repair,
  # 2026-08-30)" section). ~10,660 steps are expected to reach t_end at
  # this grid's measured dt (~4.69e-17s/step from the sibling collision-
  # only rows sharing this exact nx=5, x_max=100*dl grid); 15000 leaves
  # headroom for the extra per-step ionisation-table lookup cost this
  # family adds over the collision-only rows, never measured directly
  # (compat-B aborted before any iteration ran).
  nsteps = 15000
  t_end = 5e-13
  stdout_frequency = 1000
  print_eta_string = T
  smooth_currents = T

end:control

begin:boundaries

  bc_x_max = periodic
  bc_x_min = periodic

end:boundaries

begin:species

  name = Electron
  charge = -1
  mass = 1
  temp_ev = 500
  npart_per_cell = 2000
  density = 4e21/cc
  identify:electron

end:species

begin:species

  name = Aluminium
  charge = 4
  atomic_no = 13
  mass = 1836.2*27.0
  temp_ev = 10
  npart_per_cell = 2000
  density = 1e21/cc

  ionise = T
  ionisation_electron_species = Electron
  ionise_limit = 8

end:species

begin:collisions

  use_collisions = T
  coulomb_log = 5
  collide = all
  use_nanbu = T
  collisional_ionisation = T

end:collisions

begin:output

  nstep_snapshot = 100
  grid = always
  temperature = always + species
  number_density = always + species
  ekbar = always + species
  charge_density = always

end:output
