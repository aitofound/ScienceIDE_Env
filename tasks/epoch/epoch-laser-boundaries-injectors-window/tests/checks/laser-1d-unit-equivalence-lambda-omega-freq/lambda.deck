begin:control
  nx = 100
  t_end = 20 * femto
  x_min = -2 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  amp = 5.0e11
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 2 * femto
  dump_last = T

  grid = always
  ey = always
end:output
