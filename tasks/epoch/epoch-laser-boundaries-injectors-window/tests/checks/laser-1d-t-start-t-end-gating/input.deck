begin:control
  nx = 100
  # 35fs (was 30fs): one full 5fs dt_snapshot beyond the laser's own t_end
  # (25fs) is needed for the post-deactivation criterion this check now
  # adds (validate.py's post-t_end monotonic-non-increase test needs at
  # least two dumps strictly after t_end, not just one).
  t_end = 35 * femto
  x_min = -2 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  amp = 3.0e11
  lambda = 0.8 * micron
  t_start = 12 * femto
  t_end = 25 * femto
end:laser


begin:output
  dt_snapshot = 5 * femto
  dump_last = T

  grid = always
  ey = always
end:output
