begin:control
  nx = 50
  t_end = 50 * femto
  x_min = -1 * micron
  x_max = 1 * micron
end:control


begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
end:boundaries


begin:species
  # A cold (temperature=0), monoenergetic slab launched toward x_min with
  # bc_x_min=reflect overriding the field-level periodic boundary above
  # (deck_species_block accepts a per-species bc_x_min/bc_x_max override,
  # exactly as code/epoch/epoch1d/example_decks/injectors.deck's 'Beam'
  # species does). temperature=0 means momentum_from_temperature() adds no
  # random spread (its Gaussian sample is multiplied by sqrt(kb*T)=0), so
  # every particle starts with exactly drift_px and the reflection outcome
  # below is fully deterministic regardless of the position/velocity RNG
  # stream used only for in-slab placement.
  name = electron
  charge = -1
  mass = 1.0
  temperature = 0
  drift_px = -5.0e-23
  # Kept deliberately low so the slab's own self-consistent E/B fields
  # (space charge) are a negligible perturbation on this free-flight test:
  # this check isolates the reflect boundary formula, not collective effects.
  number_density = if(abs(x - 0.9 * micron) lt 0.05 * micron, 1.0e18, 0.0)
  nparticles_per_cell = 200
  bc_x_min = reflect
  bc_x_max = open
end:species


begin:output
  dt_snapshot = 50 * femto
  dump_last = T

  particles = always
  px = always
end:output
