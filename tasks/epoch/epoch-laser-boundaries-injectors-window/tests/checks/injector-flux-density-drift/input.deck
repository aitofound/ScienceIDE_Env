begin:control
  nx = 100
  t_end = 100 * femto
  x_min = 0
  x_max = 30 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = open
end:boundaries


begin:species
  name = Beam
  charge = -1
  mass = 1.0
  # No particles present at t=0: the injector below is the only source.
  number_density = 0
end:species


begin:injector
  boundary = x_min
  species = Beam
  # temperature=0 with a strictly positive inward drift still selects
  # injectors.F90's 'large inwards drift' branch (p_drift > flow_limit_val *
  # p_therm is p_drift > 0 when p_therm=0), so density_correction=1.0 and
  # v_inject is the exact relativistic velocity for drift_px, giving the
  # clean flux law checked in validate.py: total injected weight = n * v * T.
  number_density = 1.0e20
  temperature = 0
  drift_px = 2.0e-22
  nparticles_per_cell = 50
end:injector


begin:output
  dt_snapshot = 100 * femto
  dump_last = T

  particles = always
  px = always
  particle_weight = always
end:output
