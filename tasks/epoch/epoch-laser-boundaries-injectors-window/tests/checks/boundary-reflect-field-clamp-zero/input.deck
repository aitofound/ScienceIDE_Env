begin:constant
  x0 = 2.0 * micron
  w0 = 0.5 * micron
  lambda0 = 0.4 * micron
  amp0 = 1.0e10
end:constant


begin:control
  nx = 250
  # Identical domain/resolution/packet geometry to
  # boundary-open-outflow-absorption's input.deck (same x0/w0/lambda0/amp0,
  # same 10 points-per-wavelength Yee resolution): only bc_x_min and t_end
  # differ, so this check inherits that deck's proven numerical stability
  # instead of introducing an unvalidated new geometry.
  t_end = 30 * femto
  x_min = -5 * micron
  x_max = 5 * micron
end:control


begin:boundaries
  # bc_x_min=reflect: deck_boundaries_block.f90 sets bc_field(x_min) AND
  # bc_particle(x_min) to c_bc_reflect; boundary.F90 setup_boundaries()
  # immediately remaps the FIELD side to c_bc_clamp ("Note: reflecting EM
  # boundaries not yet implemented"), so every field update calls
  # field_clamp_zero() on ex/ey/ez (efield_bcs) and bx/by/bz (bfield_bcs) at
  # this boundary -- the exact production path this check targets. No laser
  # is attached (bc is not simple_laser), so this is a 'pure' clamp signal,
  # not the clamp-plus-laser-drive composite every laser-* check already
  # exercises transitively.
  bc_x_min = reflect
  bc_x_max = open
end:boundaries


begin:fields
  # A right-to-left (-x), Gaussian-enveloped wave packet identical in form
  # to boundary-open-outflow-absorption's: Ey=f(x+c*t), Bz=-Ey/c, so the
  # Poynting vector S=ExB/mu0 = (Ey*Bz, 0, 0) points -x, toward the
  # bc_x_min=reflect wall under test. x0 - x_min = 7 micron = 14*w0, so the
  # Gaussian envelope is already ~exp(-14^2) at the wall at t=0: negligible
  # initial overlap, so the reflection observed at the final dump is
  # entirely a consequence of the boundary, not an initial-condition
  # artifact (same margin boundary-open-outflow-absorption relies on for
  # its own identical packet geometry).
  ey = amp0 * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
  bz = -(amp0 / c) * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
end:fields


begin:output
  dt_snapshot = 30 * femto
  dump_last = T

  grid = always
  ey = always
  bz = always
end:output
