begin:constant
  x0 = 2.0 * micron
  w0 = 0.5 * micron
  lambda0 = 0.4 * micron
  amp0 = 1.0e10
end:constant


begin:control
  nx = 250
  t_end = 30 * femto
  x_min = -5 * micron
  x_max = 5 * micron
end:control


begin:boundaries
  bc_x_min = open
  bc_x_max = open
end:boundaries


begin:fields
  # A left-moving (-x), Gaussian-enveloped wave packet: Ey = f(x+c*t),
  # so Bz = -Ey/c (sign flipped relative to the +x case in
  # boundary-periodic-domain-crossing so the Poynting vector S=E x B/mu0
  # points -x, i.e. toward the bc_x_min=open boundary under test).
  ey = amp0 * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
  bz = -(amp0 / c) * gauss(x, x0, w0) * sin(2.0 * pi * (x - x0) / lambda0)
end:fields


begin:output
  dt_snapshot = 30 * femto
  dump_last = T

  grid = always
  ey = always
  bz = always
end:output
