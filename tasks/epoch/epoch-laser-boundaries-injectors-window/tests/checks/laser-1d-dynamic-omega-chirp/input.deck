begin:constant
  omega0 = 2.0 * pi * c / (0.8 * micron)
  # Linear chirp: omega(t) = omega0*(1+slope*t), reaching 1.5*omega0 by
  # t_end=20fs.
  slope = 0.5 / (20 * femto)
end:constant


begin:control
  nx = 100
  t_end = 20 * femto
  x_min = -2 * micron
  x_max = -x_min
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  amp = 3.0e11
  # Time-varying omega expression: deck_laser_block.f90's 'omega'/'freq'
  # branch tokenizes this into working_laser%omega_function; since it is
  # NOT time-invariant, 'is_time_varying' is true and
  # working_laser%use_omega_function stays .TRUE. (laser_block_start()
  # default), so laser.f90 update_laser_omegas() re-evaluates omega and
  # accumulates current_integral_phase += omega*dt EVERY step for the rest
  # of the run -- distinct from every other check in this leaf, which uses
  # a constant omega (use_omega_function left .FALSE. after the one-time
  # evaluation in deck_laser_block.f90's 'IF (.NOT. is_time_varying)
  # deallocate' branch).
  omega = omega0 * (1.0 + slope * time)
end:laser


begin:output
  # ~12-18 samples per period across the whole chirp range
  # (period0=2.67fs -> period_end=1.78fs): enough for the zero-crossing
  # interpolation validate.py performs.
  dt_snapshot = 0.15 * femto
  dump_last = T

  grid = always
  ey = always
end:output
