begin:control
  nx = 60
  ny = 60
  t_end = 12 * femto
  x_min = -1.5 * micron
  x_max = -x_min
  y_min = x_min
  y_max = x_max
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = periodic
  bc_y_max = periodic
end:boundaries


begin:laser
  boundary = x_min
  amp = 2.0e11
  lambda = 0.8 * micron
end:laser


begin:output
  dt_snapshot = 2 * femto
  dump_last = T

  grid = always
  ey = always
end:output
