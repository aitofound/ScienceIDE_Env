begin:constant
  lambda0 = 0.8 * micron
  amp0 = 1.0e10
  # 3 full wavelengths exactly fill the periodic domain, so the initial
  # condition below is itself periodic-BC-compatible (no seam discontinuity).
  lx = 3 * lambda0
end:constant


begin:control
  nx = 300

  # One full domain length of propagation at c: t_end = lx / c.
  t_end = lx / c

  x_min = 0
  x_max = lx
end:control


begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
end:boundaries


begin:fields
  # A source-free, +x-travelling plane-wave initial condition in vacuum:
  # Ey = c*Bz (Poynting vector S = E x B / mu0 points +x for this sign).
  ey = amp0 * sin(2.0 * pi * x / lambda0)
  bz = (amp0 / c) * sin(2.0 * pi * x / lambda0)
end:fields


begin:species
  # Independent, source-grounded coverage of periodic PARTICLE crossing
  # (the field IC above only exercises boundary.F90's periodic FIELD
  # exchange). A cold (temperature=0), monoenergetic beam with
  # drift_px chosen for v=c/2 exactly (relativistic p=gamma*m*v,
  # gamma=1/sqrt(1-0.25)) crosses exactly half the domain (lx/2) in this
  # deck's own t_end=lx/c, giving a clean, nonzero, exactly-predictable
  # fractional-domain shift that must wrap through bc_x_min/bc_x_max's
  # periodic particle exchange (particle_periodic_bcs()) to land back
  # inside [x_min, x_max) rather than escaping the box. Density is kept
  # low enough (1e10/m^3, versus e.g. injector-flux-density-drift's
  # 1e20/m^3) that this species' own self-field is a negligible
  # perturbation on the field test above.
  name = Beam
  charge = -1
  mass = 1.0
  temperature = 0
  drift_px = 1.5766998759610546e-22
  number_density = 1.0e10
  nparticles_per_cell = 20
end:species


begin:output
  dt_snapshot = 8.0089422319 * femto
  dump_last = T

  grid = always
  ey = always
  bz = always

  particles = always
end:output
