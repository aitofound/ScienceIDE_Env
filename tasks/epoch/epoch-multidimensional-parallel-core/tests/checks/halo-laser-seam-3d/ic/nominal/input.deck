begin:control
  nx = 70
  ny = nx
  nz = nx

  # Final time of simulation
  t_end = 50 * femto

  # Size of domain
  x_min = -10 * micron
  x_max = -x_min
  y_min = x_min
  y_max = x_max
  z_min = x_min
  z_max = x_max

  stdout_frequency = 1000000

  # Explicit Cartesian rank layout: the decomposition this check grades must
  # not depend on how many cores the machine happens to offer.
  nprocx = 2
  nprocy = 2
  nprocz = 2
  # Pin the partition to the remainder rule of mpi_routines.F90 rather than
  # to whatever the pre-run load balancer would choose.
  use_pre_balance = F
  balance_first = F
  use_random_seed = F   # EPOCH's own default, stated so the run is visibly reproducible
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = periodic
  bc_y_max = periodic
  bc_z_min = periodic
  bc_z_max = periodic
end:boundaries


begin:constant
  lambda0 = 1.06 * micron
  theta = pi / 8.0
end:constant


begin:laser
  boundary = x_min
  intensity_w_cm2 = 1.0e15
  lambda = lambda0 * cos(theta)
  phase = -2.0 * pi * y * tan(theta) / lambda0
  # polarisation_angle = 0 # pi / 2.0
  profile = gauss(r_yz, 0, 4*micron)
  # t_profile = gauss(time,4*femto,6*femto)
end:laser


begin:output
  # Simulated time between output dumps
  dt_snapshot = 25 * femto

  # Properties on grid
  grid = always
  ex = always
  #bx = always
  ey = always
  bz = always
  total_energy_sum = always + species
end:output
