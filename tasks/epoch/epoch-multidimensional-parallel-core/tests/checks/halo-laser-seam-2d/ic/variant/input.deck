begin:control
  nx = 500
  ny = nx
  nprocx = 2
  nprocy = 2

  # Final time of simulation
  t_end = 50 * femto

  # Size of domain
  x_min = -10 * micron
  x_max = -x_min
  y_min = x_min
  y_max = x_max

  use_random_seed = F
  use_pre_balance = F
  balance_first = F
  stdout_frequency = 1000000
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
  bc_y_min = periodic
  bc_y_max = periodic
end:boundaries


begin:constant
  lambda0 = 1.06 * micron
  theta = pi / 8.0
end:constant


begin:laser
  boundary = x_min
  intensity_w_cm2 = 1.0e15 * (1 + 1e-15)
  lambda = lambda0 * cos(theta)
  phase = -2.0 * pi * y * tan(theta) / lambda0
  profile = gauss(y,0,4*micron)
end:laser


begin:output
  # Simulated time between output dumps
  dt_snapshot = 25 * femto

  # Properties on grid
  grid = always
  ex = always
  ey = always
  bz = always
end:output
