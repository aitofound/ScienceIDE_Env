begin:constant

  dl = 7.4e-10

end:constant

begin:control

  x_min = 0.0
  x_max = 100*dl
  nx = 5 # SAB_NX
  t_end = 3.0e-12 # SAB_T_END
  stdout_frequency = 100000
  print_eta_string = T
  smooth_currents = T
  nprocx = 1 # EPOCH refuses to decompose 5 cells; see README

end:control

begin:boundaries

  bc_x_max = periodic
  bc_x_min = periodic

end:boundaries

begin:species

  name = electrons
  charge = -1
  mass = 1
  temp_ev = 100
  npart_per_cell = 1000 # SAB_PPC
  density = 1e22/cc

end:species

begin:species

  name = protons
  charge = 1
  mass = 1836
  temp_ev = 50
  npart_per_cell = 1000 # SAB_PPC
  density = 1e22/cc

end:species

begin:collisions

  use_collisions = T
  coulomb_log = 5
  collide = all
  use_nanbu = T

end:collisions

begin:output

  nstep_snapshot = 3300 # SAB_NSTEP_SNAPSHOT
  grid = always
  temperature = always + species
  number_density = always + species
  ekbar = always + species
  total_energy_sum = always + species

end:output
