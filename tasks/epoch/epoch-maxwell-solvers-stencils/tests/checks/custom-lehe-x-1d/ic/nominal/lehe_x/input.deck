begin:control
  nx = 240

  # Final time of simulation
  t_end = 75 * femto

  # Size of domain
  x_min = -12 * micron
  x_max = -x_min

  maxwell_solver=lehe_x
  # Fixed rank layout, so that the decomposition (and with it the halo
  # exchange order and the graded arrays) does not depend on the host.
  nprocx = 2
end:control


begin:boundaries
  bc_x_min = simple_laser
  bc_x_max = open
end:boundaries


begin:laser
  boundary = x_min
  intensity_w_cm2 = 1.0e15
  lambda = 0.5 * micron
  t_profile = gauss(time,8*femto,1.8*femto)
  t_end = 14 * femto
end:laser


begin:output
  dt_snapshot = 12 * femto

  # Properties on grid
  grid = always
  ey = always
  # Bz is the other half of the leapfrog pair advanced by update_b_field;
  # the upstream deck writes only ey. Graded together with Ey.
  bz = always
end:output
