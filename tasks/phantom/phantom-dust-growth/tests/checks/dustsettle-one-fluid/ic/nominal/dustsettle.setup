# input file for dust settling routine

# resolution
              npartx =          16

# Disc options
             rhozero =       0.001    ! midplane density (> 0 for code units; < 0 for cgs)
        stellar_mass =       1.000    ! mass of the central star [Msun]
               Rdisc =         50.    ! radius at which the calculations will be made [au]
                HonR =       0.050    ! ratio of H/R
                Rmax =         50.    ! Complete N revolutions at what radius? [au]
              norbit =          15    ! Number of orbits at Rmax

# Dust properties
   dust_to_gas_ratio =       0.010    ! dust-to-gas ratio
          ndusttypes =           0    ! number of grain sizes
        grainsizecgs =       0.100    ! grain size in [cm]
        graindenscgs =       3.000    ! grain density [g/cm^3]
