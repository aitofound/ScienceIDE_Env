# input file for linear wave setup
              npartx =          32    ! number of gas particles in x direction
             rhozero =       1.000    ! initial gas density
                  cs =       1.000    ! sound speed in code units (sets polyk)
                ampl =   1.000E-04    ! perturbation amplitude
         dust_method =           2    ! dust method (1=one fluid,2=two fluid)
                 dtg =       1.000    ! dust to gas ratio
              K_drag =       1000.    ! constant drag coefficient
