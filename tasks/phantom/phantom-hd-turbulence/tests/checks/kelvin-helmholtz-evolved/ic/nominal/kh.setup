# input file for Kelvin-Helmholtz instability setup

# resolution
                  nx =          64    ! number of particles in x direction

# physical parameters
                rho1 =       1.000    ! density of medium 1
                rho2 =  2.0000000000000000    ! density of medium 2
                  v1 =      -0.500    ! velocity of medium 1
                  v2 =       0.500    ! velocity of medium 2
              przero =       2.500    ! initial constant pressure

# geometry parameters
               xsize =       1.000    ! size of the box in x-direction
               ysize =       1.000    ! size of the box in y-direction
                 dy2 =       0.500    ! width of medium 2 (central medium)
