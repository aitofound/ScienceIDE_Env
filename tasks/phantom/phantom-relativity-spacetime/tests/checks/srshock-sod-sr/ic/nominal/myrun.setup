# Phantom v2026.0.1 (c) 2007-2025 The Authors
# input file for Phantom shock tube setup
  use_radpulse_units =           F    ! use units recommended for radiation pulse

# shock tube
            densleft =         10.    ! dens (left)
           densright =       1.000    ! dens (right)
              prleft =  13.3333333    ! pr (left)
             prright =   1.000E-06    ! pr (right)
              vxleft =       0.000    ! vx (left)
             vxright =       0.000    ! vx (right)
              vyleft =       0.000    ! vy (left)
             vyright =       0.000    ! vy (right)
              vzleft =       0.000    ! vz (left)
             vzright =       0.000    ! vz (right)

# boundaries
               xleft =      -0.500    ! x min boundary
              xright =       0.500    ! x max boundary
              xshock =       0.000    ! x shock

# resolution
                  nx =         256    ! resolution (number of particles in x) for -xleft < x < xshock
          smooth_fac =       0.000    ! smooth shock front over lengthscale smooth_fac*dxleft

# Equation-of-state properties
               gamma =  1.66666667    ! Adiabatic index (no effect if ieos=12)

# runtime parameters (written to .in file)
                tmax =       0.200    ! maximum runtime
               dtmax =       0.010    ! time between dumps
                ieos =           2    ! equation of state option
                 gmw =       2.381    ! mean molecular weight
