# input file for uniform setup routine

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)

# boundaries
     CoordBase::xmin =      -0.500    ! xmin boundary
     CoordBase::xmax =       0.50000000000000022    ! xmax boundary
     CoordBase::ymin =      -0.500    ! ymin boundary
     CoordBase::ymax =       0.500    ! ymax boundary
     CoordBase::zmin =      -0.500    ! zmin boundary
     CoordBase::zmax =       0.500    ! zmax boundary

# setup
                  nx =          64    ! number of particles in x direction
             rhozero =   13.294563    ! initial density in code units
                 cs0 =       0.000    ! initial sound speed in code units
FLRWSolver::FLRW_perturb =        "no"    ! Pertrubations of FLRW?
FLRWSolver::phi_amplitude =       0.000    ! Pertubation amplitude
FLRWSolver::phi_phase_offset =       0.000    ! Pertubation phase offset
FLRWSolver::FLRW_perturb_direction =      "none"    ! Pertubation direction
 radiation_dominated =        "no"    ! Radiation dominated universe (yes/no)
FLRWSolver::single_perturb_wavelength =       1.000    ! Perturbation wavelength
            ilattice =           1    ! lattice type (1=cubic, 2=closepacked)
