# Runtime options file for Phantom, written 02/09/2026 06:20:14.9
# Options not present assume their default values
# This file is updated automatically after a full dump

# job name
             logfile =      bk01.log    ! file to which output is directed
            dumpfile =  bk_00000.tmp   ! dump file to start from

# options controlling run time and input/output
                tmax =         0.200    ! end time
               dtmax =       0.100    ! time between dumps
                nmax =          -1    ! maximum number of timesteps (0=just get derivs and stop)
                nout =          -1    ! write dumpfile every n dtmax (-ve=ignore)
            twallmax =      000:00    ! maximum wall time (hhh:mm, 000:00=ignore)
           nfulldump =          1    ! full dump every n dumps
            iverbose =           0    ! verboseness of log (-1=quiet 0=default 1=allsteps 2=debug 5=max)
           dtwallmax =      000:00    ! maximum wall time between dumps (hhh:mm, 000:00=ignore)

# options controlling accuracy
              C_cour =       0.300    ! Courant factor
             C_force =       0.250    ! dt_force factor
                tolv =   1.000E-02    ! tolerance on v iterations in timestepping
         psidecayfac =       1.000    ! div B diffusion parameter
        overcleanfac =       1.000    ! factor to increase div B cleaning speed (decreases timestep)
               hfact =       1.000    ! h in units of particle spacing [h = hfact(m/rho)^(1/3)]
                tolh =   1.000E-04    ! tolerance on h-rho iterations

# shock capturing
               alpha =       0.000    ! MINIMUM shock viscosity parameter
            alphamax =       1.000    ! MAXIMUM shock viscosity parameter
                beta =       2.000    ! non-linear shock viscosity parameter
              alphau =       1.000    ! shock conductivity parameter
              alphaB =       1.000    ! shock resistivity parameter

# options controlling equation of state
                ieos =           2    ! eqn of state (1=isoth;2=adiab;3=locally iso;8=barotropic)
                  mu =       2.381    ! mean molecular weight
        ipdv_heating =           1    ! heating from PdV work (0=off, 1=on)
      ishock_heating =           1    ! shock heating (0=off, 1=on)
  iresistive_heating =           1    ! resistive heating (0=off, 1=on)

# options controlling cooling
            icooling =           4    ! cooling function (0=off, 1=library (step), 2=library (force),3=Gammie, 4=ISM, 5,6=KI02, 7=powerlaw, 9=radiative approx)
              C_cool =       0.050    ! factor controlling cooling timestep
         h2chemistry =           F    ! Calculate H2 chemistry
                 dlq =   3.086E+19    ! distance for column density in cooling function
               dphot =   1.080E+20    ! photodissociation distance used for CO/H2
           dphotflag =           0    ! photodissociation distance static or radially adaptive (0/1)
               dchem =   3.086E+20    ! distance for chemistry of HI
             h2ratio =       0.000    ! ratio of molecular to atomic Hydrogen       
               abHIq =       1.000    ! nHI/nH:  fraction of neutral atomic Hydrogen
               abhpq =       0.000    ! nHII/nH: fraction of ionised Hydrogen (HII) 
                abeq =       0.000    ! ne/nH:   fraction of electrons              
                abco =       0.000    ! nCO/nH:  fraction of Carbon Monoxide        
              abundc =   1.400E-04    ! Carbon abundance
              abundo =   3.200E-04    ! Oxygen abundance
             abundsi =   1.500E-05    ! Silicon abundance
              abunde =   2.000E-04    ! electron abundance
   uv_field_strength =       1.000    ! Strength of UV field (in Habing units)
   dust_to_gas_ratio =       1.000    ! dust to gas ratio
AV_conversion_factor =   5.348E-22    ! Extinction per unit column density (cm^-2)
 cosmic_ray_ion_rate =   1.000E-17    ! Cosmic ray ionisation rate of H1 (in s^-1)
              iphoto =           1    ! Photoelectric heating treatment (0=optically thin, 1=w/extinction)
          iflag_atom =           1    ! Which atomic cooling (1:Gal ISM, 2:Z=0 gas)
              Tfloor =       0.000    ! temperature floor (K); on if > 0

# options relating to external forces
      iexternalforce =           0    ! 1=star,2=coro,3=bina,4=prdr,5=toru,6=toys,7=exte,8=spir,9=Lens,10=dens,11=Eins,

# options controlling physical viscosity
           irealvisc =           0    ! physical viscosity type (0=none,1=const,2=Shakura/Sunyaev)
          shearparam =       0.100    ! magnitude of shear viscosity (irealvisc=1) or alpha_SS (irealvisc=2)
            bulkvisc =       0.000    ! magnitude of bulk viscosity

# options for injecting/removing particles
               rkill =      -1.000    ! deactivate particles outside this radius (<0 is off)

# optional outputs
               curlv =           F    ! output curl v in dump files
           track_lum =           F    ! write du/dt to dump files (for a "lightcurve")
                  gw =           F    ! calculate gravitational wave strain
