# input file for uniform setup routine

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)
           dist_unit =          au    ! distance unit (e.g. au,pc,kpc,0.1pc)

# boundaries
                xmin =      -0.500    ! xmin boundary
                xmax =       0.500    ! xmax boundary
                ymin =      -0.500    ! ymin boundary
                ymax =       0.500    ! ymax boundary
                zmin =      -0.500    ! zmin boundary
                zmax =       0.500    ! zmax boundary

# setup
                  nx =          32    ! number of particles in x direction
             rhozero =       1.000    ! initial density in code units
                 cs0 =       1.000    ! initial sound speed in code units
               gamma =  1.66666667    ! adiabatic index
            ilattice =           2    ! lattice type (1=cubic, 2=closepacked)
            iradtype =           3    ! type of radiation setup (1=uniform,2=sin diffusion,3=gaussian faster-than-light diffusion)
    gas-rad_exchange =           F    ! exchange energy  between gas and radiation
        flux_limiter =           F    ! limit radiation flux
