# Phantom v2026.0.1 (c) 2007-2025 The Authors
# input file for Phantom shock tube setup
  use_radpulse_units =           F    ! use units recommended for radiation pulse

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)
           dist_unit =          au    ! distance unit (e.g. au,pc,kpc,0.1pc)

# shock tube
            densleft =   1.683E-04    ! dens (left)
           densright =   1.683E-04    ! dens (right)
              prleft =   9.943E-07    ! pr (left)
             prright =   9.943E-07    ! pr (right)
              vxleft =  0.107438049  ! vx (left)
             vxright =  -0.107438049  ! vx (right)
              vyleft =       0.000    ! vy (left)
             vyright =       0.000    ! vy (right)
              vzleft =       0.000    ! vz (left)
             vzright =       0.000    ! vz (right)
              xileft =   4.317E-05    ! xi (left)
             xiright =   4.317E-05    ! xi (right)

# boundaries
               xleft =  -66.8449198  ! x min boundary
              xright =  66.8449198    ! x max boundary
              xshock =       0.000    ! x shock

# resolution
                  nx =         256    ! resolution (number of particles in x) for -xleft < x < xshock
          smooth_fac =       0.000    ! smooth shock front over lengthscale smooth_fac*dxleft

# Equation-of-state properties
               gamma =  1.66666667    ! Adiabatic index (no effect if ieos=12)

# radiation properties
       iopacity_type =           2    ! opacity method (0=inf,1=mesa,2=constant,-1=preserve)
           kappa_cgs =         40.    ! opacity in cm^2/g

# runtime parameters (written to .in file)
                tmax =  199.094962    ! maximum runtime
               dtmax =  1.99094962    ! time between dumps
                ieos =           2    ! equation of state option
                 gmw =       2.380    ! mean molecular weight
