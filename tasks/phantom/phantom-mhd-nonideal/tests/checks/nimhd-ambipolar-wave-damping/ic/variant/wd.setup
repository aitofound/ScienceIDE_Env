# input file for wave damping setup routines

# units and orientation
            realvals =           F    ! Using physical units (F: arbitrary units)
             isowave =           F    ! Modelling a sound wave (F: Alfven wave)
              kx_kxy =           T    ! Using wavenumber in x only (F: initialise in x,y)
               vx_vz =           F    ! Using velocity in x (F: initialise in z)

# Grid setup
              geo_cp =           T    ! Using close-packed grid (F: cubic).
                rect =           F    ! Using rectangular cp grid (F: cubic cp grid)
                  nx =          32    ! Particles in the x-direction
               rhoin =       1.0000000000000004    ! Initial density
               polyk =       1.000    ! Initial polyk
                Bxin =       1.000    ! Initial x-magnetic field
           amplitude =       0.010    ! Initial wave amplitude
               kwave =       2.000    ! Wavenumber (k/pi)

# Test problem and values
            use_ambi =           T    ! Test ambipolar diffusion?
            use_hall =           F    ! Test the Hall effect?
             use_ohm =           F    ! Test Ohmic resistivity?
