# Phantom v2026.0.1 (c) 2007-2025 The Authors
# input file for Phantom shock tube setup
  use_radpulse_units =           F    ! use units recommended for radiation pulse

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)
           dist_unit =          au    ! distance unit (e.g. au,pc,kpc,0.1pc)

# shock tube
            densleft =       1.000    ! dens (left)
           densright =       1.000    ! dens (right)
              prleft =       0.006    ! pr (left)
             prright =       0.006    ! pr (right)
              vxleft =       4.450    ! vx (left)
             vxright =      -4.450    ! vx (right)
              vyleft =       0.000    ! vy (left)
             vyright =       0.000    ! vy (right)
              vzleft =       0.000    ! vz (left)
             vzright =       0.000    ! vz (right)
              Bxleft =  0.707106781  ! Bx (left)
             Bxright =  0.707106781  ! Bx (right)
              Byleft =  0.707106781  ! By (left)
             Byright =  0.707106781  ! By (right)
              Bzleft =       0.000    ! Bz (left)
             Bzright =       0.000    ! Bz (right)

# boundaries
               xleft =  -4.000E+06    ! x min boundary
              xright =   4.000E+06    ! x max boundary
              xshock =       0.000    ! x shock

# resolution
                  nx =         200    ! resolution (number of particles in x) for -xleft < x < xshock
          smooth_fac =       0.000    ! smooth shock front over lengthscale smooth_fac*dxleft

# Equation-of-state properties
               gamma =       1.000    ! Adiabatic index (no effect if ieos=12)
               polyk =       0.010    ! square of the isothermal sound speed

# runtime parameters (written to .in file)
                tmax =   2.500E+04    ! maximum runtime
               dtmax =   1.250E+04    ! time between dumps
                ieos =           1    ! equation of state option
                 gmw =       2.381    ! mean molecular weight
             use_ohm =           F    ! include Ohmic resistivity
            use_hall =           F    ! include the Hall effect
            use_ambi =           T    ! include ambipolar diffusion
          rho_i_cnst =   1.000E-05    ! constant ion density
                C_OR =       0.100    ! Ohmic resistivity coefficient
                C_HE =      -0.500    ! Hall effect coefficient
                C_AD =   1.000E+05    ! Ambipolar diffusion coefficient
