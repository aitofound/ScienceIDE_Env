# input file for wind setup routine
        primary_mass =       1.200    ! primary star mass (Msun)
        primary_racc =      0.2568    ! primary star accretion radius (au)
         primary_lum =       5000.    ! primary star luminosity (Lsun)
        primary_Teff =       3000.    ! primary star effective temperature (K)
        primary_Reff =       1.000    ! primary star effective radius (au)
        primary_mdot =   1.000E-07    ! primary wind mass loss rate (in Msun/yr)
       primary_vwind =         10.    ! primary wind velocity (in km/s)
   primary_wind_temp =       3000.    ! primary wind temperature (K)
       primary_alpha =       0.000    ! primary alpha parameter
         primary_veq =       0.000    ! primary equatorial velocity (in km/s)
     icompanion_star =           0    ! set to 1 for a binary system, 2 for a triple system
   mass_of_particles =   1.000E-11    ! particle mass (Msun, overwritten if iwind_resolution <>0)
          wind_gamma =  1.66666667    ! adiabatic index (initial if Krome chemistry used)
