# Phantom v2026.0.1 (c) 2007-2025 The Authors
# input file for Phantom wind tunnel setup

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)
           dist_unit =      solarr    ! distance unit (e.g. au,pc,kpc,0.1pc)

# sphere settings
            add_star =           F    ! add polytropic star to the wind tunnel

# wind settings
               v_inf =        230.    ! wind speed / km s^-1
             rho_inf =       0.040    ! wind density / g cm^-3
                mach =       13.86    ! wind mach number
               gamma =  1.66666667    ! adiabatic index
               pmass =   3.194E-06    ! particle mass in code units (i.e. the mass resolution)

# wind injection settings
        lattice_type =           1    ! 0: cubic, 1: close-packed cubic
      handled_layers =           4    ! number of handled layers
         wind_radius =       1.000    ! injection radius in code units
    wind_injection_x =      -0.200    ! injection x in code units
         wind_length =       1.500    ! wind length in code units
