# input file for binary setup routines

# units
           mass_unit =      solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)
           dist_unit =      solarr    ! distance unit (e.g. au,pc,kpc,0.1pc)

# accretor settings
use_resolved_accretor =           F    ! model accretor as a full star

# orbit settings
                   a =      266.34    ! semi-major axis
                mdon =       6.970    ! mass of the donor star
                hdon =        100.    ! accretion radius of the donor star
                macc =       1.410    ! mass of the companion star
                hacc =       1.000    ! accretion radius of the companion star

# Replace sink particles with fixed gravitational potentials
            sink_off =           0    ! 0 = both stars are sink particles, 1 = both stars are fixed gravitational potentials

# mass resolution
               pmass =   1.000E-08    ! particle mass in code units

# mass injection settings
       use_mesa_file =           F    ! use_mesa_file
                mdot =   1.000E-04    ! mass transfer rate in solar mass / yr
             gastemp =       3000.    ! surface temperature of the donor star in K
               gamma =  1.66666667    ! adiabatic index
