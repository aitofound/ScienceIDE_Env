# From code/g4cmp/validation/G4Macros/Validation_BoundaryTransmission.mac: the /vis lines removed (batch run), an explicit seed and /run/verbose 1 (the end-of-run event count) added, the event count set by run.sh (SAB_EVENTS).
#-------------------------------------
# Validation_BoundaryTransmission.mac
# linehan3@fnal.gov
# 07/26/2025
#
# Validation of phonon transport across volume boundaries

#-------------------------------------
# Geometry Customs Go First
# Set geometry ID
/g4cmp/GeometryID 1
/g4cmp/StepFile Validation_BoundaryTransmission.txt

#-------------------------------------
# Initialize the run
/run/initialize
/run/verbose 1
/random/setSeeds 20260907 1

#-------------------------------------
# Set up the viewer

#-------------------------------------
# Turn off all new processes
/process/inactivate phononScattering
/process/inactivate phononDownconversion
/process/inactivate phononPolycrystalElasticScattering
/process/inactivate qpRecombination
/process/inactivate qpRadiatesPhonon
/process/inactivate scPairBreaking
/process/inactivate qpDiffusion
/process/inactivate qpLocalTrapping
/process/inactivate qpDiffusionTimeStepper

#-------------------------------------
# For printing progress and tracks
/run/printProgress 1
/tracking/verbose 0
/tracking/storeTrajectory 1

#-------------------------------------
# Set number of phonon bounces
/g4cmp/phononBounces 100

#-------------------------------------
# Generate 1 phonon per event, in a tiny parallelepiped volume
/gps/number 1
/gps/particle phononTF
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/halfx 0.0001 mm
/gps/pos/halfy 0.0001 mm
/gps/pos/halfz 0.0001 mm


#-------------------------------------
# Set the position.
/gps/pos/centre 0.0 0.0 0 mm # Center of Si
#/gps/pos/centre 0.0 0.0 -1.0 mm # Center of Ge
#/gps/pos/centre 0.0 0.0 -1.500050 mm # Center of Al1
#/gps/pos/center 0.0 0.0 -1.55 mm # Near-Center of Al2
#/gps/pos/center 0.0 0.0 -1.65 mm # Near-Center of Nb for Al3

#-------------------------------------
# Set the angular distribution. 
# For Phonon sims
/gps/ang/type iso
/gps/ene/type Mono
/gps/energy 0.0040 eV
/run/beamOn 10000
