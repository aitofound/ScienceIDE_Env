# From code/g4cmp/examples/caustics/Caustic.mac: an explicit seed and /run/verbose 1 (the end-of-run event count) added, the event count set by run.sh (SAB_EVENTS); no /vis lines upstream.
# This Macro is to Generate Phonons Caustics patterns
/run/numberOfThreads 1
/run/initialize
/run/verbose 1
/random/setSeeds 20260907 1

/gps/energy 0.03 eV
/gps/number 1
/gps/ang/type iso
/gps/pos/centre 0.0 0.0 0.0 cm

/process/inactivate phononScattering
/process/inactivate phononDownconversion
/run/beamOn 40000000
