# From code/g4cmp/examples/phonon/single.mac: /tracking/verbose set to 0 (the upstream 1 prints every step), an explicit seed and /run/verbose 1 (the end-of-run event count) added, the event count set by run.sh (SAB_EVENTS).
/run/initialize
/run/verbose 1
/random/setSeeds 20260908 2

/process/inactivate phononScattering
/process/inactivate phononDownconversion

/g4cmp/phononBounces 10000000

/tracking/verbose 0
/gun/energy 2.7e-3 eV
/gun/number 1
/run/beamOn 100
