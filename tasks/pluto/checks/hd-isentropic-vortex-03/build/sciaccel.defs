########################################################################
# ScienceAccelBench serial reference build for PLUTO.
########################################################################
CC       = gcc
CFLAGS   = -c -O3 -std=c17 -ffp-contract=off -D_DEFAULT_SOURCE -Wno-error=incompatible-pointer-types
LDFLAGS  = -lm
PARALLEL = FALSE
USE_HDF5 = FALSE
USE_PNG  = FALSE
